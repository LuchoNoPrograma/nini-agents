{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LuchoNoPrograma/nini-agents/blob/main/schema/cli-output.schema.json",
  "title": "Nini Agents CLI JSON envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "data", "error"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": {
        "properties": { "error": { "type": "null" } }
      },
      "else": {
        "properties": { "data": { "type": "null" }, "error": { "type": "object" } }
      }
    }
  ]
}
