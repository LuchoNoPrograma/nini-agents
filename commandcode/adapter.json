{
  "schemaVersion": 2,
  "id": "commandcode",
  "displayName": "Command Code",
  "kind": "cli",
  "binary": {
    "windows": ["%APPDATA%\\npm\\cmd.cmd", "%APPDATA%\\npm\\cmd", "cmd"],
    "macos": ["/usr/local/bin/cmd", "$HOME/.npm-global/bin/cmd", "cmd"],
    "linux": ["$HOME/.npm-global/bin/cmd", "/usr/local/bin/cmd", "cmd"]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "foreground",
    "env": {
      "HOME": "{runtimeRoot}/_home",
      "USERPROFILE": "{runtimeRoot}/_home"
    },
    "clearEnv": []
  },
  "account": {
    "mechanism": "inseparable",
    "credentialFiles": [],
    "credentialPrecedence": [],
    "logoutScope": "profile",
    "reason": "The current product exposes only a whole-home boundary; exact disjoint auth and session paths require live verification."
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.commandcode",
      "macos": "$HOME/.commandcode",
      "linux": "$HOME/.commandcode"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": []
  },
  "concurrency": { "level": "unsupported", "singletonScope": "unknown" },
  "support": {
    "windows": { "level": "unsupported", "reason": "Narrow auth-only isolation is not proven; legacy whole-home profiles remain available." },
    "macos": { "level": "unsupported", "reason": "Narrow auth-only isolation is not proven; legacy whole-home profiles remain available." },
    "linux": { "level": "unsupported", "reason": "Narrow auth-only isolation is not proven; legacy whole-home profiles remain available." }
  },
  "install": "npm i -g command-code",
  "versionCommand": ["--version"]
}
