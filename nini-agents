cmd_template() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    save)
      local spec="${1:-}" tpl_name="${2:-}"
      [ -z "$spec" ] || [ -z "$tpl_name" ] && abort "Usage: nini-agents template save <tool>/<profile> <name>"
      split_profile_spec "$spec"
      local sdir="$(profile_dir "$TOOL" "$NAME")"
      [ -d "$sdir" ] || abort "Profile '$spec' does not exist"
      validate_name "$tpl_name"
      if [ -f "$sdir/.profile.json" ]; then
        transfer_save_template "$(adapter_path "$TOOL")" "$sdir" "$(templates_dir)" "$tpl_name"
        return 0
      fi
      legacy_transfer_blocked "save a template from" "$spec"
      ;;
    list)
      local tdir="$(templates_dir)"
      echo "Templates:"
      if [ ! -d "$tdir" ]; then echo "  (none)"; return; fi
      local found=false d
      for d in "$tdir"/*/; do
        [ -d "$d" ] || continue
        found=true
        printf "  %-20s %s\n" "$(basename "$d")" "$(folder_size "$d")"
      done
      [ "$found" = false ] && echo "  (none)"
      ;;
    delete)
      local tpl_name="${1:-}"
      [ -z "$tpl_name" ] && abort "Usage: nini-agents template delete <name>"
      validate_name "$tpl_name"
      local dest="$(templates_dir)/$tpl_name"
      [ -d "$dest" ] || abort "Template '$tpl_name' does not exist"
      rm -rf "$dest"
      echo "Deleted template '$tpl_name'"
      ;;
    *) abort "Usage: nini-agents template <save|list|delete>" ;;
  esac
}

cmd_export() {
  local spec="${1:-}" out="${2:-}"
  [ -z "$spec" ] && abort "Usage: nini-agents export <tool>/<name> [path]"
  split_profile_spec "$spec"
  local sdir="$(profile_dir "$TOOL" "$NAME")"
  [ -d "$sdir" ] || abort "Profile '$spec' does not exist"
  [ -z "$out" ] && out="./$TOOL-$NAME.tar.gz"
  if [ -f "$sdir/.profile.json" ]; then
    transfer_export_profile "$(adapter_path "$TOOL")" "$sdir" "$out" "$NAME"
    return 0
  fi
  legacy_transfer_blocked "export" "$spec"
}

cmd_import() {
  local archive="${1:-}" spec="${2:-}"
  [ -z "$archive" ] && abort "Usage: nini-agents import <archive> <tool>/<name>"
  [ -f "$archive" ] || abort "File not found: $archive"
  [ -z "$spec" ] && abort "Usage: nini-agents import <archive> <tool>/<name>"
  split_profile_spec "$spec"
  validate_name "$NAME"
  [ -f "$(adapter_path "$TOOL")" ] || abort "Unknown tool '$TOOL'"
  local ddir="$(profile_dir "$TOOL" "$NAME")"
  [ -d "$ddir" ] && abort "Profile '$spec' already exists"
  if [ "$(json_str '.schemaVersion' "$(adapter_path "$TOOL")")" = 2 ]; then
    mkdir -p "$(tool_profiles_dir "$TOOL")"
    transfer_import_profile "$archive" "$(adapter_path "$TOOL")" "$ddir"
  else
    legacy_transfer_blocked "import into" "$spec"
  fi
  create_shell_alias "$TOOL" "$NAME"
  create_shortcut "$TOOL" "$NAME"
  echo "Imported '$spec'"
}

# Read or update the user-level Codex defaults shared by every Nini Agents
# Codex profile. An active Codex process keeps its current session policy;
# persisted values apply when a new session starts.
cmd_permissions() {
  local sub="${1:-show}" mode="${2:-}" extra="${3:-}"
  [ -z "$extra" ] || abort "Usage: nini-agents permissions show | set <read-only|workspace|full-access>"
  assert_adapter_valid codex
  load_adapter_launch_contract codex
  local config_root config binary
  config_root="$(resolve_path_token "$ADAPTER_LAUNCH_ROOT_RAW")"
  [ -n "$config_root" ] || abort "Codex adapter has no shared config root for $(platform)."
  config="$config_root/config.toml"
  case "$sub" in
    show)
      [ -z "$mode" ] || abort "Usage: nini-agents permissions show"
      codex_permissions_show "$config"
      ;;
    set)
      [ -n "$mode" ] || abort "Usage: nini-agents permissions set <read-only|workspace|full-access>"
      binary="$(find_adapter_binary codex)" || abort "OpenAI Codex CLI binary not found."
      codex_permissions_set "$config" "$mode" "$binary"
      ;;
    *) abort "Usage: nini-agents permissions show | set <read-only|workspace|full-access>" ;;
  esac
}

