}

# =============================================================================
# Launch -- strategy dispatch
# =============================================================================

# nini-agents launch <tool>/<name> [args...]: resolve the adapter, profile and
# binary, then hand off to the adapter's isolation strategy.
cmd_launch() {
  local spec="$1"; shift
  local binary_args=("$@")

  split_profile_spec "$spec"
  local apath="$(adapter_path "$TOOL")"
  load_adapter_launch_contract "$TOOL"

  local pdir="$(profile_dir "$TOOL" "$NAME")"
  [ -d "$pdir" ] || abort "Profile '$spec' does not exist. Create with: nini-agents new $spec"
  if [ "$ADAPTER_LAUNCH_SUPPORT" = unsupported ]; then
    abort "$ADAPTER_LAUNCH_DISPLAY is unsupported on $(platform): $ADAPTER_LAUNCH_SUPPORT_REASON"
  fi

  local binary
  binary="$(find_adapter_binary "$TOOL")" || {
    local hint
    hint="$ADAPTER_LAUNCH_INSTALL"
    [ -n "$hint" ] && hint=" ($hint)"
    abort "$ADAPTER_LAUNCH_DISPLAY binary not found.$hint"
  }

  local strategy display
  strategy="$ADAPTER_LAUNCH_STRATEGY"
  display="$ADAPTER_LAUNCH_DISPLAY"

  # The local Hyper integration treats these legacy-compatible markers as a
  # per-tab title lock. Keep this at the common Codex launch boundary so every
  # current or future profile alias is covered, including whole-root profiles.
  if [ "$TOOL" = codex ] && [ "${TERM_PROGRAM:-}" = Hyper ] && \
     [ "${NINI_AGENTS_HYPER_TITLE_LOCK:-}" = 1 ]; then
    printf '\033]0;__MULTICLI_TITLE_LOCK__:%s\007' "$NAME"
    trap 'printf "\033]0;__MULTICLI_TITLE_UNLOCK__\007"' EXIT
  fi

  # A pre-schema profile has no metadata and already stores the tool's complete
  # home, including its file credential, at the profile root. Preserve that
  # layout only for fileOverlay adapters: point the tool at the existing root
  # without creating metadata, auth/, or a runtime overlay. Other account
  # mechanisms keep their schema-v2 fail-closed launch path.
  if [ "$strategy" = "accountOverlay" ] && \
     [ "$ADAPTER_LAUNCH_MECHANISM" = fileOverlay ] && \
     [ ! -e "$pdir/.profile.json" ] && [ ! -L "$pdir/.profile.json" ]; then
    echo "Launching $display profile '$spec' [$strategy, legacy whole-root]"
    launch_isolated "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}"
    return
  fi

  # Isolated profiles share nothing: the profile dir is the tool's whole root,
  # so the account-overlay runtime (shared links, overlay) is bypassed.
  if [ "$strategy" = "accountOverlay" ] && [ -f "$pdir/.isolated" ]; then
    if [ "$ADAPTER_LAUNCH_MECHANISM" = osUserCredentialStore ]; then
      abort "Profile '$spec' cannot use --isolated because folder redirection does not isolate the OS credential store."
    fi
    echo "Launching $display profile '$spec' [$strategy, isolated]"
    launch_isolated "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}"
    return
  fi

  echo "Launching $display profile '$spec' [$strategy]"

  case "$strategy" in
    env)            launch_env                    "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    accountOverlay) runtime_launch_account_overlay "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    userDataDir)    launch_user_data_dir           "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    redirectHome)  launch_redirect_home "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    appdata)       launch_appdata       "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    sandboxUser)   launch_sandbox_user  "$TOOL" "$pdir" "$binary" "${binary_args[@]+"${binary_args[@]}"}" ;;
    *)             abort "Unknown isolation strategy '$strategy'" ;;
  esac
}

# Expand {profileDir} in an adapter-declared env value or argument.
expand_placeholder() {
  local val="$1" pdir="$2"
  printf '%s\n' "${val//\{profileDir\}/$pdir}"
}

# Whole-root launch for schema-v2 profiles created with --isolated and legacy
# file-overlay profiles without metadata: the profile dir is the tool's whole
# root. No runtime overlay, no shared links, nothing read from or written to the
# native shared root. fileOverlay and
# processSecret point the adapter's home env at the profile dir itself;
# processSecret additionally injects the per-profile credential (fail-closed
# until `nini-agents auth set`). osUserCredentialStore and inseparable get a
# whole-home redirect into <profile>/_home -- no OS user, no shared state.
launch_isolated() {
  local tool="$1" pdir="$2" binary="$3"; shift 3
  local apath mechanism profile_id=""
  apath="$(adapter_path "$tool")"
  mechanism="$(json_str '.account.mechanism' "$apath")"
  [ -f "$pdir/.profile.json" ] && profile_id="$(runtime_profile_id "$pdir")"

  local secret_env_var="" process_secret=""
  if [ "$mechanism" = processSecret ]; then
    secret_env_var="$(json_str '.account.secret.environmentVariable' "$apath")"
    [ -n "$secret_env_var" ] || abort "Adapter '$tool' is missing account.secret.environmentVariable."
    [ -n "$profile_id" ] || abort "Profile '$tool/$(basename "$pdir")' is missing schema-v2 metadata."
    process_secret="$(mc_cred_get "$(mc_cred_target "$tool" "$profile_id" "$secret_env_var")")" || \
      abort "Profile '$tool/$(basename "$pdir")' has no stored credential. Run: nini-agents auth set $tool/$(basename "$pdir")"
  fi

  # Both {runtimeRoot} and {sharedStateRoot} resolve to the profile dir: in
  # isolated mode the profile is the root, so no placeholder can leak a path
  # into the native shared root.
  # A whole-root launch either replaces the profile id with metadata's value or
  # clears a stale inherited value for a legacy profile.
  local env_args=() unset_args=("-u" "MULTICLI_PROFILE_ID") key value
  while IFS= read -r key; do
    [ -z "$key" ] && continue
    value="$(json_obj_val '.isolation.env' "$key" "$apath")"
    value="$(runtime_expand_value "$value" "$pdir" "$profile_id" "$pdir/auth" "$pdir" "$pdir")"
    env_args+=("$key=$value")
  done < <(json_obj_keys '.isolation.env' "$apath")
  while IFS= read -r key; do
    [ -z "$key" ] && continue
    unset_args+=("-u" "$key")
  done < <(runtime_json_arr '.isolation.clearEnv' "$apath")
  [ -n "$profile_id" ] && env_args+=("MULTICLI_PROFILE_ID=$profile_id")
  [ -n "$secret_env_var" ] && env_args+=("$secret_env_var=$process_secret")

  local mode
  mode="$(json_str '.isolation.mode' "$apath")"
  local launch_env=()
  case "$mechanism" in
    fileOverlay|processSecret)
      launch_env=("${env_args[@]+"${env_args[@]}"}")
      ;;
    *)
      local hdir="$pdir/_home" tmpdir="$pdir/_home/.tmp"
      mkdir -p "$hdir" "$tmpdir"
      case "$(platform)" in
        macos)
          launch_env=(HOME="$hdir" TMPDIR="$tmpdir"
            XDG_CONFIG_HOME="$hdir/.config" XDG_DATA_HOME="$hdir/.local/share"
            XDG_CACHE_HOME="$hdir/.cache" XDG_STATE_HOME="$hdir/.local/state"
            XDG_RUNTIME_DIR="$tmpdir" "${env_args[@]+"${env_args[@]}"}")
          ;;
        linux)
          launch_env=(HOME="$hdir" TMPDIR="$tmpdir" TEMP="$tmpdir" TMP="$tmpdir"
            XDG_CONFIG_HOME="$hdir/.config" XDG_DATA_HOME="$hdir/.local/share"
            XDG_CACHE_HOME="$hdir/.cache" XDG_STATE_HOME="$hdir/.local/state"
            XDG_RUNTIME_DIR="$tmpdir" "${env_args[@]+"${env_args[@]}"}")
          ;;
        *)
          launch_env=(HOME="$hdir" USERPROFILE="$hdir"
            APPDATA="$hdir/AppData/Roaming" LOCALAPPDATA="$hdir/AppData/Local"
            TEMP="$tmpdir" TMP="$tmpdir" TMPDIR="$tmpdir"
            "${env_args[@]+"${env_args[@]}"}")
          ;;
      esac
      ;;
  esac
  if [ "$mode" = detached ]; then
    env "${unset_args[@]+"${unset_args[@]}"}" "${launch_env[@]+"${launch_env[@]}"}" "$binary" "$@" \
      > "$pdir/.isolated-launch.log" 2>&1 &
    return 0
  fi
  env "${unset_args[@]+"${unset_args[@]}"}" "${launch_env[@]+"${launch_env[@]}"}" "$binary" "$@"
}

# env strategy: the whole isolation is the adapter's env map, expanded and
# set for the child only.
launch_env() {
  local tool="$1" pdir="$2" binary="$3"; shift 3
  local apath="$(adapter_path "$tool")"
  local env_cmd=()

  while IFS= read -r key; do
    [ -z "$key" ] && continue
    local val
    val="$(json_obj_val '.isolation.env' "$key" "$apath")"
    val="$(expand_placeholder "$val" "$pdir")"
    env_cmd+=("$key=$val")
  done < <(json_obj_keys '.isolation.env' "$apath")

  env "${env_cmd[@]+"${env_cmd[@]}"}" "$binary" "$@"
}

# userDataDir strategy: pass the adapter's --user-data-dir-style args and
# point HOME/TMPDIR/XDG at <profile>/_home so nothing leaks to the real home.
launch_user_data_dir() {
  local tool="$1" pdir="$2" binary="$3"; shift 3
  local apath="$(adapter_path "$tool")"
  local args=()

  while IFS= read -r a; do
    [ -z "$a" ] && continue
    args+=("$(expand_placeholder "$a" "$pdir")")
  done < <(json_arr '.isolation.args' "$apath")

  local hdir="$pdir/_home"
  local tmpdir="$hdir/.tmp"
  mkdir -p "$hdir" "$tmpdir"

  case "$(platform)" in
    macos)
      env HOME="$hdir" TMPDIR="$tmpdir" \
          XDG_CONFIG_HOME="$hdir/.config" \
          XDG_DATA_HOME="$hdir/.local/share" \
          XDG_CACHE_HOME="$hdir/.cache" \
          XDG_STATE_HOME="$hdir/.local/state" \
          XDG_RUNTIME_DIR="$tmpdir" \
          "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
    linux)
      env HOME="$hdir" TMPDIR="$tmpdir" TEMP="$tmpdir" TMP="$tmpdir" \
          XDG_CONFIG_HOME="$hdir/.config" \
          XDG_DATA_HOME="$hdir/.local/share" \
          XDG_CACHE_HOME="$hdir/.cache" \
          XDG_STATE_HOME="$hdir/.local/state" \
          XDG_RUNTIME_DIR="$tmpdir" \
          "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
    *)
      env HOME="$hdir" TMPDIR="$tmpdir" \
          "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
  esac
}

# redirectHome strategy: like userDataDir, but the adapter's shareFromRealHome
# dotfiles are linked into the redirected home first, and any extra isolation
# env is applied.
launch_redirect_home() {
  local tool="$1" pdir="$2" binary="$3"; shift 3
  local apath="$(adapter_path "$tool")"
  local hdir="$pdir/_home"
  local tmpdir="$hdir/.tmp"
  mkdir -p "$hdir" "$tmpdir"
  set_redirect_home_links "$tool" "$hdir"

  local extra_env=()
  local _keys
  _keys="$(json_obj_keys '.isolation.env' "$apath")"
  if [ -n "$_keys" ]; then
    while IFS= read -r key; do
      [ -z "$key" ] && continue
      local val
      val="$(json_obj_val '.isolation.env' "$key" "$apath")"
      val="$(expand_placeholder "$val" "$pdir")"
      extra_env+=("$key=$val")
    done <<< "$_keys"
  fi

  case "$(platform)" in
    macos)
      env HOME="$hdir" TMPDIR="$tmpdir" XDG_CONFIG_HOME="$hdir/.config" \
          XDG_DATA_HOME="$hdir/.local/share" XDG_CACHE_HOME="$hdir/.cache" \
          XDG_STATE_HOME="$hdir/.local/state" XDG_RUNTIME_DIR="$tmpdir" \
          "${extra_env[@]+"${extra_env[@]}"}" "$binary" "$@"
      ;;
    linux)
      env HOME="$hdir" TMPDIR="$tmpdir" TEMP="$tmpdir" TMP="$tmpdir" \
          XDG_CONFIG_HOME="$hdir/.config" XDG_DATA_HOME="$hdir/.local/share" \
          XDG_CACHE_HOME="$hdir/.cache" XDG_STATE_HOME="$hdir/.local/state" \
          XDG_RUNTIME_DIR="$tmpdir" "${extra_env[@]+"${extra_env[@]}"}" "$binary" "$@"
      ;;
    *)
      env HOME="$hdir" TMPDIR="$tmpdir" "${extra_env[@]+"${extra_env[@]}"}" "$binary" "$@"
      ;;
  esac
}

# Create the mcli_<name> OS user owning the profile dir (sudo; first launch
# only). Prints the username.
create_sandbox_user() {
  local name="$1" pdir="$2"
  local username="mcli_${name}"

  case "$(platform)" in
    macos)
      if ! dscl . -read /Users/"$username" &>/dev/null; then
        local maxid
        maxid=$(dscl . -list /Users UniqueID | awk '{print $2}' | sort -n | tail -1)
        local uid=$((maxid + 1))
        sudo dscl . -create /Users/"$username"
        sudo dscl . -create /Users/"$username" UniqueID "$uid"
        sudo dscl . -create /Users/"$username" PrimaryGroupID 20
        sudo dscl . -create /Users/"$username" UserShell /usr/bin/false
        sudo dscl . -create /Users/"$username" NFSHomeDirectory "$pdir/_home"
        sudo dscl . -create /Users/"$username" IsHidden 1
        sudo dscl . -create /Users/"$username" RealName "multi-cli sandbox $name"
        sudo mkdir -p "$pdir/_home"
        sudo chown -R "$username":staff "$pdir"
      fi
      ;;
    linux)
      if ! id "$username" &>/dev/null; then
        sudo useradd --system --no-create-home --home-dir "$pdir/_home" --shell /usr/sbin/nologin "$username"
        sudo mkdir -p "$pdir/_home"
        sudo chown -R "$username":"$username" "$pdir"
      fi
      ;;
  esac
  printf '%s' "$username"
}

# sandboxUser strategy: run the binary as the profile's dedicated OS user so
# kernel-level credential stores (keychain, Secret Service) are per-profile.
launch_sandbox_user() {
  local tool="$1" pdir="$2" binary="$3"; shift 3
  local apath="$(adapter_path "$tool")"
  local profile_name
  profile_name="$(basename "$pdir")"
  local username="mcli_${profile_name}"
  case "$(platform)" in
    macos)
      if ! dscl . -read /Users/"$username" &>/dev/null; then
        echo "First launch: creating sandbox user (requires sudo)..."
        create_sandbox_user "$profile_name" "$pdir"
      fi
      ;;
    linux)
      if ! id "$username" &>/dev/null; then
        echo "First launch: creating sandbox user (requires sudo)..."
        create_sandbox_user "$profile_name" "$pdir"
      fi
      ;;
  esac

  local args=()
  if json_has '.isolation.args' "$apath"; then
    while IFS= read -r a; do
      [ -z "$a" ] && continue
      args+=("$(expand_placeholder "$a" "$pdir")")
    done < <(json_arr '.isolation.args' "$apath")
  fi

  case "$(platform)" in
    macos)
      sudo -u "$username" "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
    linux)
      xhost +si:localuser:"$username" 2>/dev/null || true
      local uid
      uid=$(id -u "$username" 2>/dev/null || echo "")
      sudo -u "$username" \
        DISPLAY="${DISPLAY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="/run/user/${uid}" \
        DBUS_SESSION_BUS_ADDRESS="" \
        "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
    *)
      env HOME="$pdir/_home" "$binary" "${args[@]+"${args[@]}"}" "$@"
      ;;
  esac
}

launch_appdata() {
  abort "appdata strategy is Windows-only; use redirectHome on macOS/Linux"
}

# =============================================================================
# Listings & diagnostics
# =============================================================================

format_bytes() {
  local bytes="$1"
  if [ "$bytes" -ge 1073741824 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f GB\", $bytes/1073741824}"
  elif [ "$bytes" -ge 1048576 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f MB\", $bytes/1048576}"
  elif [ "$bytes" -ge 1024 ] 2>/dev/null; then
    awk "BEGIN{printf \"%.2f KB\", $bytes/1024}"
  else
    echo "$bytes B"
  fi
}

# Human-readable size of a directory tree; "0 B" for anything missing.
folder_size() {
  local p="$1"
  [ -d "$p" ] || { echo "0 B"; return; }
  local bytes
  if [ "$(platform)" = "macos" ]; then
    bytes="$(du -sk "$p" 2>/dev/null | awk '{print $1 * 1024}')" || bytes=0
  else
    bytes="$(du -sb "$p" 2>/dev/null | awk '{print $1}')" || bytes=0
  fi
  format_bytes "$bytes"
}

# Logical bytes in regular files. Symlinks are not followed, so a JSON query
# cannot escape the requested profile or template tree.
folder_size_bytes() {
  local p="$1" total=0 f bytes
  [ -d "$p" ] || { printf '0\n'; return; }
  while IFS= read -r -d '' f; do
    bytes="$(stat -c '%s' "$f" 2>/dev/null || stat -f '%z' "$f" 2>/dev/null || printf '0')"
    case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
    total=$((total + bytes))
  done < <(find "$p" -type f -print0 2>/dev/null)
  printf '%s\n' "$total"
}

json_profile_data() {
  local tool_filter="${1:-}" tool_dir tname pdir pname ptype schema_version size
  {
    if [ -d "$BASE" ]; then
      for tool_dir in "$BASE"/*/; do
        tool_dir="${tool_dir%/}"
        [ -d "$tool_dir" ] && [ ! -L "$tool_dir" ] || continue
        tname="$(basename "$tool_dir")"
        [[ "$tname" == .* ]] && continue
        [ "$tname" = bin ] && continue
        [ -n "$tool_filter" ] && [ "$tname" != "$tool_filter" ] && continue
        for pdir in "$tool_dir"/*/; do
          pdir="${pdir%/}"
          [ -d "$pdir" ] && [ ! -L "$pdir" ] || continue
          pname="$(basename "$pdir")"
          ptype=full
          [ -f "$pdir/.cli" ] && ptype=cli
          [ -f "$pdir/.shared" ] && ptype=shared
          [ -f "$pdir/.isolated" ] && ptype=isolated
          schema_version=1
          [ -f "$pdir/.profile.json" ] && schema_version=2
          size="$(folder_size_bytes "$pdir")"
          jq -cn --arg tool "$tname" --arg name "$pname" --arg type "$ptype" \
            --argjson schemaVersion "$schema_version" --argjson sizeBytes "$size" \
            '{tool:$tool,name:$name,type:$type,schemaVersion:$schemaVersion,sizeBytes:$sizeBytes}'
        done
      done
    fi
  } | jq -sc '{profiles:.,count:length}'
}

json_tools_array() {
  local tid apath kind strategy support installed
  {
    for tid in $(list_tool_ids | sort); do
      apath="$(adapter_path "$tid")"
      kind="$(json_str '.kind' "$apath")"
      strategy="$(json_str '.isolation.strategy' "$apath")"
      support="$(json_str ".support.$(platform).level" "$apath")"
      [ -n "$support" ] || support="$(json_str '.status' "$apath")"
      [ -n "$support" ] || support=unknown
      if find_adapter_binary "$tid" >/dev/null 2>&1; then installed=true; else installed=false; fi
      jq -cn --arg id "$tid" --arg kind "$kind" --arg strategy "$strategy" \
        --arg supportLevel "$support" --argjson installed "$installed" \
        '{id:$id,kind:$kind,strategy:$strategy,supportLevel:$supportLevel,installed:$installed}'
    done
  } | jq -sc '.'
}

# Parse a public profile address without invoking abort(), so JSON mutations can
# return one deterministic envelope even for malformed input.
json_mutation_parse_spec() {
  local spec="$1"
  JSON_MUTATION_TOOL=""
  JSON_MUTATION_NAME=""
  if [[ "$spec" =~ ^([a-zA-Z0-9][a-zA-Z0-9-]*)/([a-zA-Z0-9][a-zA-Z0-9-]*)$ ]]; then
    JSON_MUTATION_TOOL="${BASH_REMATCH[1]}"
    JSON_MUTATION_NAME="${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

json_new_flags_valid() {
  local shared=false isolated=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --shared) shared=true ;;
      --isolated|--isolate|-i) isolated=true ;;
      --cli|--no-seed) ;;
      --from)
        shift
        [ $# -gt 0 ] && [ -n "$1" ] || return 1
        ;;
      *) return 1 ;;
    esac
    shift
  done
  [ "$shared" != true ] || [ "$isolated" != true ]
}

json_profile_mutation_summary() {
  local tool="$1" name="$2" pdir="$3" profile_type=full schema_version=1
  [ -f "$pdir/.cli" ] && profile_type=cli
  [ -f "$pdir/.shared" ] && profile_type=shared
  [ -f "$pdir/.isolated" ] && profile_type=isolated
  [ -f "$pdir/.profile.json" ] && schema_version=2
  jq -cn --arg tool "$tool" --arg name "$name" --arg type "$profile_type" \
    --argjson schemaVersion "$schema_version" \
    '{tool:$tool,name:$name,type:$type,schemaVersion:$schemaVersion}'
}

cmd_json_new() {
  local spec="${1:-}" tool name pdir status state profile data
  [ $# -gt 0 ] || {
    cli_json_mutation_error new invalid_identifier 'A valid profile address is required.' not_applied
    return 2
  }
  shift
  json_mutation_parse_spec "$spec" || {
    cli_json_mutation_error new invalid_identifier 'A valid profile address is required.' not_applied
    return 2
  }
  tool="$JSON_MUTATION_TOOL"
  name="$JSON_MUTATION_NAME"
  json_new_flags_valid "$@" || {
    cli_json_mutation_error new invalid_arguments 'The new command received invalid arguments.' not_applied
    return 2
  }
  pdir="$BASE/$tool/$name"
  if [ -e "$pdir" ] || [ -L "$pdir" ]; then
    cli_json_mutation_error new profile_exists 'The destination profile already exists.' not_applied
    return 2
  fi

  set +e
  ( set -e; cmd_new "$spec" "$@" ) >/dev/null 2>/dev/null
  status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    state=not_applied
    if [ -e "$pdir" ] || [ -L "$pdir" ]; then state=partially_applied; fi
    cli_json_mutation_error new operation_failed 'The profile could not be created.' "$state"
    return 6
  fi

  profile="$(json_profile_mutation_summary "$tool" "$name" "$pdir")"
  data="$(jq -cn --argjson profile "$profile" '{state:"applied",profile:$profile}')"
  cli_json_success new "$data"
}

cmd_json_rename() {
  local old="${1:-}" new="${2:-}" old_tool old_name new_tool new_name
  local old_dir new_dir status state profile data
  [ $# -eq 2 ] || {
    cli_json_mutation_error rename invalid_arguments 'The rename command requires exactly two profile addresses.' not_applied
    return 2
  }
  json_mutation_parse_spec "$old" || {
    cli_json_mutation_error rename invalid_identifier 'The source profile address is invalid.' not_applied
    return 2
  }
  old_tool="$JSON_MUTATION_TOOL"
  old_name="$JSON_MUTATION_NAME"
  json_mutation_parse_spec "$new" || {
    cli_json_mutation_error rename invalid_identifier 'The destination profile address is invalid.' not_applied
    return 2
  }
  new_tool="$JSON_MUTATION_TOOL"
  new_name="$JSON_MUTATION_NAME"
  if [ "$old_tool" != "$new_tool" ]; then
    cli_json_mutation_error rename cross_tool_rename 'Profiles cannot be renamed across tools.' not_applied
    return 2
  fi

  old_dir="$BASE/$old_tool/$old_name"
  new_dir="$BASE/$new_tool/$new_name"
  if [ ! -d "$old_dir" ]; then
    cli_json_mutation_error rename profile_not_found 'The source profile does not exist.' not_applied
    return 2
  fi
  if [ -e "$new_dir" ] || [ -L "$new_dir" ]; then
    cli_json_mutation_error rename profile_exists 'The destination profile already exists.' not_applied
    return 2
  fi

  set +e
  ( set -e; cmd_rename "$old" "$new" ) >/dev/null 2>/dev/null
  status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    state=not_applied
    if [ ! -d "$old_dir" ] && [ -d "$new_dir" ]; then state=partially_applied; fi
    cli_json_mutation_error rename operation_failed 'The profile could not be renamed.' "$state"
    return 6
  fi

  profile="$(json_profile_mutation_summary "$new_tool" "$new_name" "$new_dir")"
  data="$(jq -cn \
    --arg oldTool "$old_tool" --arg oldName "$old_name" --argjson profile "$profile" \
    '{state:"applied",from:{tool:$oldTool,name:$oldName},profile:$profile}')"
  cli_json_success rename "$data"
}

cmd_json_delete() {
  local spec="${1:-}" tool name pdir status data
  [ $# -gt 0 ] || {
    cli_json_mutation_error delete invalid_identifier 'A valid profile address is required.' not_applied
    return 2
  }
  json_mutation_parse_spec "$spec" || {
    cli_json_mutation_error delete invalid_identifier 'A valid profile address is required.' not_applied
    return 2
  }
  tool="$JSON_MUTATION_TOOL"
  name="$JSON_MUTATION_NAME"
  if [ $# -ne 3 ] || [ "$2" != --confirm ] || [ "$3" != "$spec" ]; then
    cli_json_mutation_error delete confirmation_required 'JSON deletion requires --confirm followed by the exact profile address.' not_applied
    return 2
  fi

  set +e
  pdir="$(profile_dir "$tool" "$name" 2>/dev/null)"
  status=$?
  set -e
  if [ "$status" -ne 0 ]; then
    cli_json_mutation_error delete operation_failed 'The profile could not be safely resolved.' not_applied
    return 6
  fi
  if [ ! -d "$pdir" ]; then
    cli_json_mutation_error delete profile_not_found 'The profile does not exist.' not_applied
    return 2
  fi

  set +e
  ( set -e; cmd_delete "$spec" true ) >/dev/null 2>/dev/null
  status=$?
  set -e
  if [ "$status" -ne 0 ] || [ -d "$pdir" ]; then
    cli_json_mutation_error delete operation_failed 'The profile could not be completely deleted.' partially_applied
    return 6
  fi

  data="$(jq -cn --arg tool "$tool" --arg name "$name" \
    '{state:"applied",profile:{tool:$tool,name:$name}}')"
  cli_json_success delete "$data"
}

cmd_json_query() {
  local command="$1" arg1="${2:-}" arg2="${3:-}" data tools storage_exists storage_writable total
  case "$command" in
    version|--version|-v)
      [ -z "$arg1" ] || { cli_json_error version invalid_arguments 'This JSON command received unsupported arguments.'; return 2; }
      cli_json_success version "$(jq -cn --arg product nini-agents --arg version "$VERSION" '{product:$product,version:$version}')"
      ;;
    list|status)
      [ -z "$arg2" ] || { cli_json_error "$command" invalid_arguments 'This JSON command received unsupported arguments.'; return 2; }
      data="$(json_profile_data "$arg1")"
      cli_json_success "$command" "$data"
      ;;
    tools)
      [ -z "$arg1" ] || { cli_json_error tools invalid_arguments 'This JSON command received unsupported arguments.'; return 2; }
      tools="$(json_tools_array)"
      data="$(jq -cn --arg platform "$(platform)" --argjson tools "$tools" '{platform:$platform,tools:$tools,count:($tools|length)}')"
      cli_json_success tools "$data"
      ;;
    doctor)
      [ -z "$arg1" ] || { cli_json_error doctor invalid_arguments 'JSON doctor does not support deep runtime auditing yet.'; return 2; }
      if [ -d "$BASE" ]; then
        storage_exists=true
        if [ -w "$BASE" ]; then storage_writable=true; else storage_writable=false; fi
      else
        storage_exists=false
        if [ -w "$(dirname "$BASE")" ]; then storage_writable=true; else storage_writable=false; fi
      fi
      tools="$(json_tools_array)"
      data="$(jq -cn \
        --arg platform "$(platform)" \
        --argjson exists "$storage_exists" \
        --argjson writable "$storage_writable" \
        --argjson aliasDirectoryOnPath "$(alias_dir_in_path && printf true || printf false)" \
        --argjson tools "$tools" \
        '{platform:$platform,storage:{exists:$exists,writable:$writable},aliasDirectoryOnPath:$aliasDirectoryOnPath,tools:$tools}')"
      if [ "$storage_writable" = true ]; then
        cli_json_success doctor "$data"
      else
        cli_json_error doctor health_check_failed 'One or more required health checks failed.' \
          "$(jq -cn --argjson result "$data" '{result:$result}')"
        return 6
      fi
      ;;
    stats)
      [ -z "$arg1" ] || { cli_json_error stats invalid_arguments 'This JSON command received unsupported arguments.'; return 2; }
      data="$(json_profile_data '')"
      total="$(printf '%s' "$data" | jq '[.profiles[].sizeBytes] | add // 0')"
      data="$(printf '%s' "$data" | jq -c --argjson totalBytes "$total" '{profiles:.profiles,count:.count,totalBytes:$totalBytes}')"
      cli_json_success stats "$data"
      ;;
    template)
      [ "$arg1" = list ] && [ -z "$arg2" ] || {
        cli_json_error template json_unsupported 'JSON output is not available for this command.'
        return 2
      }
      data="$({
        local tdir d name size
        tdir="$(templates_dir)"
        if [ -d "$tdir" ]; then
          for d in "$tdir"/*/; do
            d="${d%/}"
            [ -d "$d" ] && [ ! -L "$d" ] || continue
            name="$(basename "$d")"
            size="$(folder_size_bytes "$d")"
            jq -cn --arg name "$name" --argjson sizeBytes "$size" '{name:$name,sizeBytes:$sizeBytes}'
          done
        fi
      } | jq -sc '{templates:.,count:length}')"
      cli_json_success template-list "$data"
      ;;
    *)
      cli_json_error "${command:-unknown}" json_unsupported 'JSON output is not available for this command.'
      return 2
      ;;
  esac
}

cmd_list() {
  local tool_filter="${1:-}"
  [ -d "$BASE" ] || { echo "No profiles yet."; return; }

  local tool_dir
  for tool_dir in "$BASE"/*/; do
    [ -d "$tool_dir" ] || continue
    local tname="$(basename "$tool_dir")"
    [[ "$tname" == .* ]] && continue
    [ "$tname" = "bin" ] && continue
    [ -n "$tool_filter" ] && [ "$tname" != "$tool_filter" ] && continue

    echo ""
    printf '\033[36m[%s]\033[0m\n' "$tname"
    local pdir found=false
    for pdir in "$tool_dir"*/; do
      [ -d "$pdir" ] || continue
      found=true
      local pname="$(basename "$pdir")"
      local ptype="full"
      [ -f "$pdir/.cli" ] && ptype="cli"
      [ -f "$pdir/.shared" ] && ptype="shared"
      [ -f "$pdir/.isolated" ] && ptype="isolated"
      printf "  %-20s %-8s %s\n" "$pname" "$ptype" "$(folder_size "$pdir")"
    done
    [ "$found" = false ] && echo "  (none)"
  done
  return 0
}

cmd_tools() {
  echo "Supported tools:"
  echo ""
  printf "  %-18s %-12s %-15s %-10s %s\n" "TOOL" "KIND" "STRATEGY" "STATUS" "INSTALLED"
  printf "  %-18s %-12s %-15s %-10s %s\n" "----" "----" "--------" "------" "---------"

  local tid
  for tid in $(list_tool_ids | sort); do
    local apath="$(adapter_path "$tid")"
    local kind strategy status reason installed color
    kind="$(json_str '.kind' "$apath")"
    strategy="$(json_str '.isolation.strategy' "$apath")"
    status="$(json_str ".support.$(platform).level" "$apath")"
    reason="$(json_str ".support.$(platform).reason" "$apath")"
    [ -z "$status" ] && status="$(json_str '.status' "$apath")"
    [ -z "$status" ] && status="?"
    if find_adapter_binary "$tid" >/dev/null 2>&1; then
      installed="yes"; color="\033[32m"
    else
      installed="no"; color="\033[90m"
    fi
    printf "  ${color}%-18s %-12s %-15s %-10s %s\033[0m\n" "$tid" "$kind" "$strategy" "$status" "$installed"
    [ -n "$reason" ] && printf '    %s\n' "$reason"
  done
}

cmd_doctor() {
  local deep="${1:-}"
  local errors=0 warnings=0
  echo "nini-agents $VERSION  --  $(platform)"
  echo ""
  echo "Profile storage: $BASE"

  if [ -d "$BASE" ]; then
    if touch "$BASE/.write-test" 2>/dev/null; then
      rm -f "$BASE/.write-test"
      printf '  \033[32m[OK] writable\033[0m\n'
    else
      printf '  \033[31m[FAIL] not writable\033[0m\n'
      errors=$((errors + 1))
    fi
  else
    echo "  [INFO] not yet created (will be created on first profile)"
  fi

  if alias_dir_in_path; then
    printf 'Alias dir in PATH: \033[32myes\033[0m\n'
  else
    printf 'Alias dir in PATH: \033[33mno\033[0m  (%s -- add to PATH for shorthand commands)\n' "$(alias_dir)"
    warnings=$((warnings + 1))
  fi

  echo ""
  echo "Tools:"
  local tid
  for tid in $(list_tool_ids | sort); do
    if ! validate_adapter_manifest "$(adapter_path "$tid")" "$tid"; then
      printf '  \033[31m[FAIL] %s adapter is invalid\033[0m\n' "$tid"
      local validation_error
      for validation_error in "${ADAPTER_VALIDATION_ERRORS[@]}"; do
        printf '         %s\n' "$validation_error"
      done
      errors=$((errors + 1))
      continue
    fi
    local bin
    if bin="$(find_adapter_binary "$tid")"; then
      printf '  \033[32m[OK]   %s -> %s\033[0m\n' "$tid" "$bin"
    else
      local hint
      hint="$(json_str '.install' "$(adapter_path "$tid")")"
      [ -n "$hint" ] && hint="  install: $hint"
      printf '  \033[90m[MISS] %s%s\033[0m\n' "$tid" "$hint"
    fi
    local support_level support_reason
    support_level="$(json_str ".support.$(platform).level" "$(adapter_path "$tid")")"
    support_reason="$(json_str ".support.$(platform).reason" "$(adapter_path "$tid")")"
    if [ -n "$support_reason" ]; then
      if [ "$support_level" = unsupported ]; then
        printf '         \033[33m%s: %s\033[0m\n' "$support_level" "$support_reason"
      else
        printf '         %s: %s\n' "$support_level" "$support_reason"
      fi
    fi
  done

  if [ "$deep" = "--deep" ]; then
    echo ""
    echo "Runtime audit (schema-v2 profiles):"
    local profile_json pdir runtime rel f
    if [ -d "$BASE" ]; then
      for profile_json in "$BASE"/*/*/.profile.json; do
        [ -f "$profile_json" ] || continue
        pdir="$(dirname "$profile_json")"
        runtime="$pdir/.runtime"
        [ -d "$runtime" ] || continue
        if [ ! -f "$runtime/.runtime-manifest" ]; then
          printf '  \033[33m[WARN] %s runtime has no manifest (built before audit support)\033[0m\n' "$pdir"
          warnings=$((warnings + 1))
          continue
        fi
        local apath expected item expected_target state_subdir declared credential_path credential shared_credential_root runtime_path runtime_generated
        apath="$(adapter_path "$(basename "$(dirname "$pdir")")")"
        state_subdir="$(runtime_json_str '.normalState.runtimeSubdir' "$apath")"
        shared_credential_root="$(runtime_shared_credential_root "$apath" "$pdir" 2>/dev/null || true)"
        while IFS= read -r rel; do
          [ -n "$rel" ] || continue
          item="$runtime/$rel"
          if [ ! -e "$item" ] && [ ! -L "$item" ]; then
            printf '  \033[33m[WARN] missing declared runtime path %s in %s -- relaunch the profile\033[0m\n' "$rel" "$pdir"
            warnings=$((warnings + 1))
            continue
          fi
          declared="$rel"
          [ -z "$state_subdir" ] || declared="${rel#${state_subdir}/}"
          credential=false
          while IFS= read -r credential_path; do
            [ "$credential_path" = "$declared" ] && credential=true && break
          done < <(runtime_json_arr '.account.credentialFiles' "$apath")
          if [ "$credential" = true ]; then
            expected_target="$pdir/auth/$declared"
          elif [ -n "$shared_credential_root" ] && runtime_is_shared_credential_path "$apath" "$declared"; then
            expected_target="$shared_credential_root/$declared"
          else
            expected_target="$(runtime_platform_root "$apath")/$declared"
          fi
          if [ ! -e "$expected_target" ] || [ ! "$item" -ef "$expected_target" ]; then
            printf '  \033[33m[WARN] runtime link %s has the wrong target in %s\033[0m\n' "$rel" "$pdir"
            warnings=$((warnings + 1))
          fi
        done < "$runtime/.runtime-manifest"
        while IFS= read -r f; do
          rel="${f#"$runtime"/}"
          [ "$rel" = ".runtime-manifest" ] && continue
          if ! grep -qxF "$rel" "$runtime/.runtime-manifest"; then
            runtime_generated=false
            while IFS= read -r runtime_path; do
              [ -n "$runtime_path" ] || continue
              expected="${state_subdir:+$state_subdir/}$runtime_path"
              case "$rel" in "$expected"|"$expected"/*) runtime_generated=true; break ;; esac
            done < <(runtime_json_arr '.normalState.runtimePaths' "$apath")
            [ "$runtime_generated" = true ] && continue
            printf '  \033[33m[WARN] unexpected runtime file %s in %s -- adapter classification defect\033[0m\n' "$rel" "$pdir"
            warnings=$((warnings + 1))
          fi
        done < <(find "$runtime" -type f 2>/dev/null)
      done
    fi
  fi

  echo ""
  if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
    printf '\033[32mAll good.\033[0m\n'
    return 0
  elif [ $errors -eq 0 ]; then
    printf '\033[33m%d warning(s).\033[0m\n' "$warnings"
    [ "$deep" = --deep ] && return 1
    return 0
  else
    printf '\033[31m%d error(s), %d warning(s).\033[0m\n' "$errors" "$warnings"
  fi
  return 1
}

cmd_stats() {
  [ -d "$BASE" ] || { echo "No profiles yet."; return; }
  printf "%-30s %s\n" "PROFILE" "SIZE"
  local td
  for td in "$BASE"/*/; do
    [ -d "$td" ] || continue
    local tname="$(basename "$td")"
    [[ "$tname" == .* ]] && continue
    [ "$tname" = "bin" ] && continue
    local pd
    for pd in "$td"*/; do
      [ -d "$pd" ] || continue
      printf "%-30s %s\n" "$tname/$(basename "$pd")" "$(folder_size "$pd")"
    done
  done
  echo ""
  echo "Total: $(folder_size "$BASE")"
}

