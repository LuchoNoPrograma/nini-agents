  nini-agents <tool>/<name> [args...]   -- same as 'launch'

ENVIRONMENT
  MULTICLI_HOME              Profile storage root (default ~/MultiCliProfiles)
  MULTICLI_OVERRIDE_BINARY   Override binary discovery for the next launch

EXAMPLES
  nini-agents new claude-cli/work
  nini-agents new codex/acme --isolated
  nini-agents new opencode/personal --isolated
  nini-agents launch codex/acme -- exec --search "fix the build"
  nini-agents continue codex acme backup   # resume a rate-limited chat under another profile
  claude-cli-work          # via auto-generated alias on \$PATH

HELP
}

cmd_completion() {
  local shell="${1:-bash}"
  case "$shell" in
    bash)
      cat <<'COMP'
_multi_cli_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local base="${MULTICLI_HOME:-$HOME/MultiCliProfiles}"
  local script_dir="$(cd "$(dirname "$(command -v nini-agents 2>/dev/null || echo .)")" && pwd)"
  local tools_dir="${MULTICLI_TOOLS_DIR:-$script_dir/ai-tools}"
  local cmds="new launch list status rename delete clone migrate continue auth permissions template export import tools doctor stats completion help version"
  local tools="" specs=""
  if [ -d "$tools_dir" ]; then
    for d in "$tools_dir"/*/; do [ -f "$d/adapter.json" ] && tools="$tools $(basename "$d")"; done
  fi
  if [ -d "$base" ]; then
    for td in "$base"/*/; do
      [ -d "$td" ] || continue
      local tn="$(basename "$td")"
      [[ "$tn" == .* ]] && continue; [ "$tn" = "bin" ] && continue
      for pd in "$td"/*/; do [ -d "$pd" ] && specs="$specs $tn/$(basename "$pd")"; done
    done
  fi
  COMPREPLY=($(compgen -W "$cmds $tools $specs" -- "$cur"))
}
complete -F _multi_cli_completions nini-agents multi-cli
COMP
      ;;
    zsh)
      cat <<'COMP'
#compdef nini-agents multi-cli
_multi_cli() {
  local -a cmds tools specs
  cmds=(new launch list status rename delete clone migrate continue auth permissions template export import tools doctor stats completion help version)
  local base="${MULTICLI_HOME:-$HOME/MultiCliProfiles}"
  local script_dir="$(cd "$(dirname "$(command -v nini-agents 2>/dev/null || echo .)")" && pwd)"
  local tools_dir="${MULTICLI_TOOLS_DIR:-$script_dir/ai-tools}"
  if [ -d "$tools_dir" ]; then
    for d in "$tools_dir"/*/; do [ -f "$d/adapter.json" ] && tools+=($(basename "$d")); done
  fi
  if [ -d "$base" ]; then
    for td in "$base"/*/; do
      [ -d "$td" ] || continue
      local tn="$(basename "$td")"
      [[ "$tn" == .* ]] && continue; [ "$tn" = "bin" ] && continue
      for pd in "$td"/*/; do [ -d "$pd" ] && specs+=("$tn/$(basename "$pd")"); done
    done
  fi
  _arguments '1: :->cmd' '*: :->args'
  case $state in
    cmd) _describe 'command' cmds -- tools -- specs ;;
  esac
}
_multi_cli "$@"
COMP
      ;;
    *) echo "Supported: bash, zsh" ;;
  esac
}

# =============================================================================
# Main dispatch
# =============================================================================

CLI_JSON=false
cli_args=()
cli_after_delimiter=false
for cli_arg in "$@"; do
  if [ "$cli_after_delimiter" = false ] && [ "$cli_arg" = -- ]; then
    cli_after_delimiter=true
    cli_args+=("$cli_arg")
  elif [ "$cli_after_delimiter" = false ] && [ "$cli_arg" = --json ]; then
    CLI_JSON=true
  else
    cli_args+=("$cli_arg")
  fi
done
set -- "${cli_args[@]+"${cli_args[@]}"}"

if ! command -v jq >/dev/null 2>&1; then
  if [ "$CLI_JSON" = true ]; then
    printf '%s\n' '{"schemaVersion":1,"command":"unknown","ok":false,"data":null,"error":{"code":"dependency_missing","message":"jq is required for JSON output."}}'
    exit 6
  fi
  need_jq
fi

if [ "$CLI_JSON" = true ]; then
  if [ "${1:-}" = new ]; then
    set +e
    cmd_json_new "${@:2}"
    cli_json_status=$?
    set -e
    exit "$cli_json_status"
  fi
  if [ "${1:-}" = rename ]; then
    set +e
    cmd_json_rename "${@:2}"
    cli_json_status=$?
    set -e
    exit "$cli_json_status"
  fi
  if [ "${1:-}" = delete ]; then
    set +e
    cmd_json_delete "${@:2}"
    cli_json_status=$?
    set -e
    exit "$cli_json_status"
  fi
  set +e
  cli_json_output="$(cmd_json_query "${1:-}" "${2:-}" "${3:-}" 2>/dev/null)"
  cli_json_status=$?
  set -e
  if printf '%s' "$cli_json_output" | jq -se '
    (length == 1) and (.[0].schemaVersion == 1) and
    ((.[0].ok | type) == "boolean") and
    (.[0] | has("data") and has("error"))
  ' >/dev/null 2>&1; then
    printf '%s\n' "$cli_json_output"
    exit "$cli_json_status"
  fi
  cli_json_error "${1:-unknown}" operation_failed 'The JSON query could not be completed.'
  exit 6
fi

cmd="${1:-}"
shift || true

case "$cmd" in
  new)        cmd_new "$@" ;;
  auth)       cmd_auth "$@" ;;
  permissions) cmd_permissions "$@" ;;
  launch)
    spec="${1:-}"; shift || true
    launch_args=()
    saw_delim=false
    for a in "$@"; do
      if [ "$saw_delim" = false ] && [ "$a" = "--" ]; then saw_delim=true; continue; fi
      launch_args+=("$a")
    done
    cmd_launch "$spec" "${launch_args[@]+"${launch_args[@]}"}"
    ;;
  list)       cmd_list "${1:-}" ;;
  status)     cmd_list "${1:-}" ;;
  rename)     cmd_rename "${1:-}" "${2:-}" ;;
  delete)     cmd_delete "${1:-}" ;;
  clone)      cmd_clone "${1:-}" "${2:-}" ;;
  migrate)    cmd_migrate "$@" ;;
  continue)   cmd_continue "$@" ;;
  template)   cmd_template "$@" ;;
  export)     cmd_export "$@" ;;
  import)     cmd_import "$@" ;;
  tools)      cmd_tools ;;
  doctor)     cmd_doctor "${1:-}" ;;
  stats)      cmd_stats ;;
  completion) cmd_completion "${1:-bash}" ;;
  help|--help|-h) cmd_help ;;
  version|--version|-v) echo "nini-agents $VERSION" ;;
  "")         cmd_help; exit 1 ;;
  *)
    if [[ "$cmd" == */* ]]; then
      cmd_launch "$cmd" "$@"
    else
      echo "Unknown command: $cmd"
      cmd_help
      exit 1
    fi
    ;;
esac
