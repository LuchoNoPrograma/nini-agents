#!/usr/bin/env bash
# nini-agents -- Run multiple sandboxed profiles of any supported AI CLI or IDE.
#
# Adapter-driven launcher: each supported tool ships an adapter.json describing
# how to find its binary and how to isolate its state. nini-agents reads the
# adapter and applies its isolation strategy: env, userDataDir, redirectHome,
# appdata, sandboxUser, or accountOverlay (schema-v2).

set -euo pipefail
shopt -s nullglob

VERSION="1.0.0"

SCRIPT_DIR="${SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
TOOLS_DIR="${MULTICLI_TOOLS_DIR:-$SCRIPT_DIR/ai-tools}"
BASE="${MULTICLI_HOME:-$HOME/MultiCliProfiles}"

# shellcheck source=lib/adapter-validation.sh
source "$SCRIPT_DIR/lib/adapter-validation.sh"
# shellcheck source=lib/multicli-runtime.sh
source "$SCRIPT_DIR/lib/multicli-runtime.sh"
# shellcheck source=lib/credential-store.sh
source "$SCRIPT_DIR/lib/credential-store.sh"
# shellcheck source=lib/transfer.sh
source "$SCRIPT_DIR/lib/transfer.sh"
# shellcheck source=lib/migration.sh
source "$SCRIPT_DIR/lib/migration.sh"
# shellcheck source=lib/multicli-osuser.sh
source "$SCRIPT_DIR/lib/multicli-osuser.sh"
# shellcheck source=lib/cli-json.sh
source "$SCRIPT_DIR/lib/cli-json.sh"
# shellcheck source=lib/codex-permissions.sh
source "$SCRIPT_DIR/lib/codex-permissions.sh"

# Skip automatic session seeding when the base state exceeds this size.
SEED_MAX_BYTES=$((500 * 1024 * 1024))

# =============================================================================
# Utilities
# =============================================================================

abort() { echo "Error: $1" >&2; exit 1; }
warn()  { echo "Warning: $1" >&2; }

# Canonical platform name: macos, linux, or windows (Git Bash/MSYS/Cygwin).
# MULTICLI_PLATFORM overrides detection (tests, cross-platform validation).
NINI_PLATFORM_CACHE=""
platform() {
  local raw
  if [ -n "${MULTICLI_PLATFORM:-}" ]; then
    raw="$MULTICLI_PLATFORM"
  elif [ -n "$NINI_PLATFORM_CACHE" ]; then
    printf '%s\n' "$NINI_PLATFORM_CACHE"
    return
  else
    raw="$(uname -s)"
  fi
  case "$raw" in
    Darwin|darwin|macOS|MacOS|macos|Mac|mac|OSX|osx) NINI_PLATFORM_CACHE=macos ;;
    Linux|linux) NINI_PLATFORM_CACHE=linux ;;
    MINGW*|mingw*|MSYS*|msys*|CYGWIN*|cygwin*|Windows*|windows*) NINI_PLATFORM_CACHE=windows ;;
    *) abort "unsupported platform '$raw'" ;;
  esac
  printf '%s\n' "$NINI_PLATFORM_CACHE"
}

need_jq() {
  command -v jq >/dev/null 2>&1 || abort "jq is required but not installed. Install via: brew install jq / apt install jq"
}

# jq readers: missing paths/files yield empty output, never a launcher crash
# (the trailing fallback keeps the exit status clean under `set -o pipefail`).
json_str() { jq -r "$1 // empty" "$2" 2>/dev/null | tr -d '\r' || echo ""; }
json_arr() { jq -r "$1 // empty | .[]?" "$2" 2>/dev/null | tr -d '\r' || true; }
json_obj_keys() { jq -r "$1 // {} | keys[]" "$2" 2>/dev/null | tr -d '\r' || true; }
json_obj_val() { jq -r "$1[\"$2\"] // empty" "$3" 2>/dev/null | tr -d '\r' || echo ""; }
json_has() {
  local path="$1" file="$2"
  jq -e "$path" "$file" >/dev/null 2>&1
}

# =============================================================================
# Adapter loading
# =============================================================================

adapter_path() { printf '%s/%s/adapter.json\n' "$TOOLS_DIR" "$1"; }

list_tool_ids() {
  local d
  for d in "$TOOLS_DIR"/*/; do
    [ -f "$d/adapter.json" ] && basename "$d"
  done
}

# Launches parse one trusted, bundled adapter in a single jq process. Full
# semantic validation stays on creation/mutation and doctor paths; the hot
# path keeps only the fields it consumes and runtime path checks remain
# fail-closed at the filesystem boundary.
ADAPTER_LAUNCH_TOOL=""
ADAPTER_LAUNCH_MANIFEST=""
ADAPTER_LAUNCH_ID=""
ADAPTER_LAUNCH_DISPLAY=""
ADAPTER_LAUNCH_STRATEGY=""
ADAPTER_LAUNCH_MODE=""
ADAPTER_LAUNCH_MECHANISM=""
ADAPTER_LAUNCH_SUPPORT=""
ADAPTER_LAUNCH_SUPPORT_REASON=""
ADAPTER_LAUNCH_INSTALL=""
ADAPTER_LAUNCH_ROOT_RAW=""
ADAPTER_LAUNCH_STATE_SUBDIR=""
ADAPTER_LAUNCH_SHARED_CREDENTIAL_ROOT=""
ADAPTER_LAUNCH_BINARIES=()
ADAPTER_LAUNCH_ENV_KEYS=()
ADAPTER_LAUNCH_ENV_VALUES=()
ADAPTER_LAUNCH_CLEAR_ENV=()
ADAPTER_LAUNCH_ARGS=()
ADAPTER_LAUNCH_CREDENTIAL_PATHS=()
ADAPTER_LAUNCH_SHARED_PATHS=()
ADAPTER_LAUNCH_SESSION_PATHS=()
ADAPTER_LAUNCH_FILE_PATHS=()
ADAPTER_LAUNCH_DIRECT_PATHS=()
ADAPTER_LAUNCH_SHARED_CREDENTIAL_PATHS=()
ADAPTER_LAUNCH_SHARED_CREDENTIAL_KINDS=()

load_adapter_launch_contract() {
  local tool_id="$1" manifest plat record name value complete=false
  validate_tool_id "$tool_id"
  manifest="$(adapter_path "$tool_id")"
  [ -f "$manifest" ] || abort "Unknown tool '$tool_id'. Run: nini-agents tools"
  plat="$(platform)"

  ADAPTER_LAUNCH_TOOL="$tool_id"
  ADAPTER_LAUNCH_MANIFEST="$manifest"
  ADAPTER_LAUNCH_ID=""
  ADAPTER_LAUNCH_DISPLAY=""
  ADAPTER_LAUNCH_STRATEGY=""
  ADAPTER_LAUNCH_MODE=""
  ADAPTER_LAUNCH_MECHANISM=""
  ADAPTER_LAUNCH_SUPPORT=""
  ADAPTER_LAUNCH_SUPPORT_REASON=""
  ADAPTER_LAUNCH_INSTALL=""
  ADAPTER_LAUNCH_ROOT_RAW=""
  ADAPTER_LAUNCH_STATE_SUBDIR=""
  ADAPTER_LAUNCH_SHARED_CREDENTIAL_ROOT=""
  ADAPTER_LAUNCH_BINARIES=()
  ADAPTER_LAUNCH_ENV_KEYS=()
  ADAPTER_LAUNCH_ENV_VALUES=()
  ADAPTER_LAUNCH_CLEAR_ENV=()
  ADAPTER_LAUNCH_ARGS=()
  ADAPTER_LAUNCH_CREDENTIAL_PATHS=()
  ADAPTER_LAUNCH_SHARED_PATHS=()
  ADAPTER_LAUNCH_SESSION_PATHS=()
  ADAPTER_LAUNCH_FILE_PATHS=()
  ADAPTER_LAUNCH_DIRECT_PATHS=()
  ADAPTER_LAUNCH_SHARED_CREDENTIAL_PATHS=()
  ADAPTER_LAUNCH_SHARED_CREDENTIAL_KINDS=()

  while IFS= read -r -d '' record && \
        IFS= read -r -d '' name && \
        IFS= read -r -d '' value; do
    case "$record:$name" in
      scalar:id) ADAPTER_LAUNCH_ID="$value" ;;
      scalar:display) ADAPTER_LAUNCH_DISPLAY="$value" ;;
      scalar:strategy) ADAPTER_LAUNCH_STRATEGY="$value" ;;
      scalar:mode) ADAPTER_LAUNCH_MODE="$value" ;;
      scalar:mechanism) ADAPTER_LAUNCH_MECHANISM="$value" ;;
      scalar:support) ADAPTER_LAUNCH_SUPPORT="$value" ;;
      scalar:support-reason) ADAPTER_LAUNCH_SUPPORT_REASON="$value" ;;
      scalar:install) ADAPTER_LAUNCH_INSTALL="$value" ;;
      scalar:root) ADAPTER_LAUNCH_ROOT_RAW="$value" ;;
      scalar:state-subdir) ADAPTER_LAUNCH_STATE_SUBDIR="$value" ;;
      scalar:shared-credential-root) ADAPTER_LAUNCH_SHARED_CREDENTIAL_ROOT="$value" ;;
      binary:*) ADAPTER_LAUNCH_BINARIES+=("$name") ;;
      env:*) ADAPTER_LAUNCH_ENV_KEYS+=("$name"); ADAPTER_LAUNCH_ENV_VALUES+=("$value") ;;
      clear:*) ADAPTER_LAUNCH_CLEAR_ENV+=("$name") ;;
      arg:*) ADAPTER_LAUNCH_ARGS+=("$name") ;;
      credential:*) ADAPTER_LAUNCH_CREDENTIAL_PATHS+=("$name") ;;
      shared:*) ADAPTER_LAUNCH_SHARED_PATHS+=("$name") ;;
      session:*) ADAPTER_LAUNCH_SESSION_PATHS+=("$name") ;;
      file:*) ADAPTER_LAUNCH_FILE_PATHS+=("$name") ;;
      direct:*) ADAPTER_LAUNCH_DIRECT_PATHS+=("$name") ;;
      shared-credential:*) ADAPTER_LAUNCH_SHARED_CREDENTIAL_PATHS+=("$name"); ADAPTER_LAUNCH_SHARED_CREDENTIAL_KINDS+=("$value") ;;
      complete:yes) complete=true ;;
    esac
  done < <(jq -j --arg platform "$plat" '
    def row($record; $name; $value):
      $record, "\u0000", (($name // "") | tostring), "\u0000", (($value // "") | tostring), "\u0000";
    if any(.. | strings; contains("\u0000")) then error("adapter strings may not contain NUL")
    else
      row("scalar"; "id"; .id),
      row("scalar"; "display"; .displayName),
      row("scalar"; "strategy"; .isolation.strategy),
      row("scalar"; "mode"; .isolation.mode),
      row("scalar"; "mechanism"; .account.mechanism),
      row("scalar"; "support"; .support[$platform].level),
      row("scalar"; "support-reason"; .support[$platform].reason),
      row("scalar"; "install"; .install),
      row("scalar"; "root"; .normalState.root[$platform]),
      row("scalar"; "state-subdir"; .normalState.runtimeSubdir),
      row("scalar"; "shared-credential-root"; .sharedCredentialState.root),
      ((.binary[$platform] // [])[] | row("binary"; .; "")),
      ((.isolation.env // {} | to_entries[]) | row("env"; .key; .value)),
      ((.isolation.clearEnv // [])[] | row("clear"; .; "")),
      ((.isolation.args // [])[] | row("arg"; .; "")),
      ((.account.credentialFiles // [])[] | row("credential"; .; "")),
      ((.normalState.sharedPaths // [])[] | row("shared"; .; "")),
      ((.normalState.sessionPaths // [])[] | row("session"; .; "")),
      ((.normalState.filePaths // [])[] | row("file"; .; "")),
      ((.normalState.directPaths // [])[] | row("direct"; .; "")),
      ((.sharedCredentialState.entries // [])[] | row("shared-credential"; .path; .kind)),
      row("complete"; "yes"; "")
    end
  ' "$manifest" 2>/dev/null)

  [ "$complete" = true ] || abort "Adapter '$tool_id' is not valid JSON or has an unreadable launch contract. Run: nini-agents doctor"
  [ "$ADAPTER_LAUNCH_ID" = "$tool_id" ] || abort "Adapter directory '$tool_id' does not match id '$ADAPTER_LAUNCH_ID'. Run: nini-agents doctor"
  [ -n "$ADAPTER_LAUNCH_DISPLAY" ] || abort "Adapter '$tool_id' has no displayName. Run: nini-agents doctor"
  [ "${#ADAPTER_LAUNCH_BINARIES[@]}" -gt 0 ] || abort "Adapter '$tool_id' has no binary candidates for $plat. Run: nini-agents doctor"
  case "$ADAPTER_LAUNCH_STRATEGY" in
    env|accountOverlay|userDataDir|redirectHome|appdata|sandboxUser) ;;
    *) abort "Unknown isolation strategy '$ADAPTER_LAUNCH_STRATEGY'" ;;
  esac
}

# Expand the path tokens adapters use for per-OS roots: $HOME/~ everywhere,
# %USERPROFILE%/%APPDATA%/%LOCALAPPDATA% on Windows only.
resolve_path_token() {
  local p="$1"
  p="${p//\$HOME/$HOME}"
  p="${p//\~/$HOME}"
  if [ "$(platform)" = windows ]; then
    p="${p//%USERPROFILE%/${USERPROFILE:-$HOME}}"
    p="${p//%APPDATA%/${APPDATA:-}}"
    p="${p//%LOCALAPPDATA%/${LOCALAPPDATA:-}}"
  fi
  printf '%s\n' "$p"
}

# Abort unless the tool's adapter exists and passes semantic validation.
# Mutation and audit commands use this exhaustive path; launch uses the
# single-pass contract loader plus at-use runtime path guards.
assert_adapter_valid() {
  local tool_id="$1" manifest
  validate_tool_id "$tool_id"
  manifest="$(adapter_path "$tool_id")"
  [ -f "$manifest" ] || abort "Unknown tool '$tool_id'. Run: nini-agents tools"
  if ! validate_adapter_manifest "$manifest" "$tool_id"; then
    local validation_error
    for validation_error in "${ADAPTER_VALIDATION_ERRORS[@]}"; do
      warn "$tool_id adapter invalid: $validation_error"
    done
    abort "Invalid adapter '$tool_id'. Run: nini-agents doctor"
  fi
}

# Print the first binary candidate that exists (path or PATH lookup) for the
# current platform; returns 1 when none resolve. MULTICLI_OVERRIDE_BINARY wins.
find_windows_appx_binary() {
  local candidate="$1"
  [ "$(platform)" = windows ] || return 1
  command -v powershell.exe >/dev/null 2>&1 || return 1
  MULTICLI_WINDOWS_BINARY_CANDIDATE="$candidate" powershell.exe -NoProfile -NonInteractive -Command '
    $candidate = $env:MULTICLI_WINDOWS_BINARY_CANDIDATE
    if ($candidate -notlike "appx:*") { exit 1 }
    $parts = $candidate.Substring(5).Split("!", 2)
    if ($parts.Count -ne 2) { exit 1 }
    $package = Get-AppxPackage -Name $parts[0] -PackageTypeFilter Main -ErrorAction SilentlyContinue |
      Where-Object { $_.SignatureKind -eq "Store" } |
      Sort-Object Version -Descending | Select-Object -First 1
    if ($null -eq $package) { exit 1 }
    $application = @((Get-AppxPackageManifest -Package $package).Package.Applications.Application) |
      Where-Object { $_.Id -eq $parts[1] } | Select-Object -First 1
    if ($null -eq $application) { exit 1 }
    Write-Output ("appx:{0}!{1}" -f $package.PackageFamilyName, $parts[1])
  ' 2>/dev/null | tr -d '\r'
}

find_adapter_binary() {
  local tool_id="$1"
  [ -n "${MULTICLI_OVERRIDE_BINARY:-}" ] && { printf '%s\n' "$MULTICLI_OVERRIDE_BINARY"; return 0; }

  local apath plat key c resolved
  local candidates=()
  apath="$(adapter_path "$tool_id")"
  plat="$(platform)"
  key=".binary.$plat"
  if [ "$ADAPTER_LAUNCH_TOOL" = "$tool_id" ] && [ "$ADAPTER_LAUNCH_MANIFEST" = "$apath" ]; then
    candidates=("${ADAPTER_LAUNCH_BINARIES[@]}")
  else
    while IFS= read -r c; do [ -n "$c" ] && candidates+=("$c"); done < <(jq -r "$key // [] | .[]" "$apath" 2>/dev/null || true)
  fi

  for c in "${candidates[@]}"; do
    [ -z "$c" ] && continue
    case "$c" in
      appx:*)
        [ "$(json_str '.isolation.strategy' "$apath")" = accountOverlay ] || continue
        [ "$(json_str '.account.mechanism' "$apath")" = osUserCredentialStore ] || continue
        resolved="$(find_windows_appx_binary "$c")" && [ -n "$resolved" ] && {
          printf '%s\n' "$resolved"
          return 0
        }
        continue
        ;;
      uri:*) continue ;;
    esac
    resolved="$(resolve_path_token "$c")"
    [ -x "$resolved" ] && { printf '%s\n' "$resolved"; return 0; }
    command -v "$resolved" >/dev/null 2>&1 && { command -v "$resolved"; return 0; }
  done

  return 1
}

# =============================================================================
# Profile addressing
# =============================================================================

# Parse and validate <tool>/<name> into the TOOL and NAME globals.
split_profile_spec() {
  local spec="$1"
  [ -z "$spec" ] && abort "Profile required: <tool>/<name>"
  [[ "$spec" == */* ]] || abort "Profile must be in form <tool>/<name>. Got: '$spec'"
  TOOL="${spec%%/*}"
  NAME="${spec#*/}"
  validate_tool_id "$TOOL"
  validate_name "$NAME"
}

# Adapter ids are single safe path components. Validate them before any
# adapter or profile path is joined.
validate_tool_id() {
  local tool_id="$1"
  [ -z "$tool_id" ] && abort "Tool id required"
  [[ "$tool_id" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || abort "Tool id '$tool_id' invalid: must start with alphanumeric, contain only letters/numbers/hyphens"
}

# Abort unless $1 is a safe profile/template name: alnum start, then
# alnum or hyphen. This is what keeps profile specs inside the storage root.
validate_name() {
  local name="$1"
  [ -z "$name" ] && abort "Profile name required"
  [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || abort "Profile name '$name' invalid: must start with alphanumeric, contain only letters/numbers/hyphens"
}

# Canonicalize a path even when its final components do not exist by resolving
# the nearest existing ancestor and appending only the missing names.
storage_canonical() {
  local path="$1" probe="$1" suffix="" parent canonical
  while [ ! -e "$probe" ] && [ ! -L "$probe" ]; do
    suffix="/$(basename "$probe")$suffix"
    parent="$(dirname "$probe")"
    [ "$parent" != "$probe" ] || return 1
    probe="$parent"
  done
  canonical="$(transfer_canonical "$probe")" || return 1
  printf '%s%s\n' "${canonical%/}" "$suffix"
}

# Resolve a storage path only while each existing component stays physically
# under MULTICLI_HOME. This rejects symlink/junction escapes while allowing a
# caller-selected MULTICLI_HOME itself to be a link.
storage_path() {
  local label="$1"; shift
  local canonical_base current segment canonical_current
  canonical_base="$(storage_canonical "$BASE")" || abort "Cannot resolve MULTICLI_HOME '$BASE'."
  current="$BASE"
  for segment in "$@"; do
    [ -n "$segment" ] || continue
    current="$current/$segment"
    if [ -e "$current" ] || [ -L "$current" ]; then
      canonical_current="$(transfer_canonical "$current")" || abort "Cannot resolve $label '$current'."
      transfer_path_within "$canonical_current" "$canonical_base" || \
        abort "Refusing to access $label because '$current' resolves outside MULTICLI_HOME."
    fi
  done
  printf '%s\n' "$current"
}

profile_dir() {
  validate_tool_id "$1"
  validate_name "$2"
  storage_path "profile '$1/$2'" "$1" "$2"
}
tool_profiles_dir() {
  validate_tool_id "$1"
  storage_path "profile root for '$1'" "$1"
}
alias_dir()     { storage_path "alias directory" bin; }
templates_dir() { storage_path "template root" .templates; }

legacy_transfer_blocked() {
  local action="$1" spec="$2"
  abort "Cannot $action '$spec': legacy profile transfer is disabled because whole-root copies can leak tokens. Migrate the legacy profile first: nini-agents migrate $spec"
}

legacy_template_apply_blocked() {
  local spec="$1" tpl_name="$2"
  abort "Cannot create '$spec' from template '$tpl_name': legacy template application is disabled because old on-disk templates can contain credentials. Recreate the template from a migrated schema-v2 profile."
}

# =============================================================================
# Session continuation -- copy conversation state between endpoints
# =============================================================================

# The tool's real system home, derived from the adapter's declared systemHome
# or, failing that, from the directory its isolation env var points at.
adapter_system_home() {
  local tool="$1" apath sys_home key
  apath="$(adapter_path "$tool")"
  if [ "$(json_str '.schemaVersion' "$apath")" = 2 ]; then
    sys_home="$(json_str ".normalState.root.$(platform)" "$apath")"
    [ -z "$sys_home" ] && return 1
    resolve_path_token "$sys_home"
    return
  fi
  sys_home="$(json_str '.share.systemHome' "$apath")"
  if [ -z "$sys_home" ]; then
    key="$(json_obj_keys '.isolation.env' "$apath" | head -1)"
    [ -n "$key" ] && sys_home="$(json_obj_val '.isolation.env' "$key" "$apath")"
    sys_home="${sys_home//\{profileDir\}/}"
  fi
  [ -z "$sys_home" ] && return 1
  resolve_path_token "$sys_home"
}

# Resolve an endpoint name to a directory: 'base' is the tool's system home,
# anything else is a profile directory.
resolve_session_endpoint() {
  local tool="$1" name="$2"
  if [ "$name" = "base" ]; then
    adapter_system_home "$tool"
  else
    validate_name "$name"
    profile_dir "$tool" "$name"
  fi
}

# Abort if an adapter-declared relative path is unsafe to join under a root:
# absolute, drive-qualified, or containing a '..' component. These would let
# adapter data escape the endpoint directory.
assert_relpath_safe() {
  local p="$1" kind="$2" tool="$3"
  case "$p" in
    /*|\\*)        abort "adapter bug: $kind '$p' is absolute in $tool" ;;
    [a-zA-Z]:*)    abort "adapter bug: $kind '$p' has a drive letter in $tool" ;;
  esac
  case "/${p//\\//}/" in
    */../*)        abort "adapter bug: $kind '$p' contains '..' in $tool" ;;
  esac
}

# Abort if any session path equals, contains, or is contained by a credential
# entry -- that combination would leak credentials and is an adapter bug.
# Also reject any traversal/absolute paths in either list.
assert_session_paths_safe() {
  local tool="$1" apath p c
  apath="$(adapter_path "$tool")"
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    assert_relpath_safe "$c" "credential" "$tool"
  done < <(json_arr '.session.credentials' "$apath")
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    assert_relpath_safe "$p" "session path" "$tool"
    while IFS= read -r c; do
      [ -z "$c" ] && continue
      if [ "$p" = "$c" ] || [[ "$p" == "$c"/* ]] || [[ "$c" == "$p"/* ]]; then
        abort "adapter bug: session path '$p' overlaps credential '$c' in $tool"
      fi
    done < <(json_arr '.session.credentials' "$apath")
  done < <(json_arr '.session.paths' "$apath")
}

# mtime of a file in epoch seconds (portable across GNU/BSD stat).
file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# size of a file in bytes (portable across GNU/BSD stat).
file_size() {
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0
}

# hard-link count of a file (portable across GNU/BSD stat). A legitimate
# conversation rollout file always has nlink 1; a count above 1 means the file
# is a hardlink (possibly to a credential), matching PS's LinkType == HardLink.
file_nlink() {
  stat -c %h "$1" 2>/dev/null || stat -f %l "$1" 2>/dev/null || echo 1
}

# True when src should be skipped because dest is current: dest mtime strictly
# newer, or equal mtime with equal size. A truncated/partial dest with an equal
# mtime but a different size is NOT current and will be repaired.
dest_is_current() {
  local src="$1" dst="$2" sm dm ss ds
  [ -e "$dst" ] || return 1
  sm="$(file_mtime "$src")"; dm="$(file_mtime "$dst")"
  if [ "$dm" -gt "$sm" ]; then return 0; fi
  if [ "$dm" -eq "$sm" ]; then
    ss="$(file_size "$src")"; ds="$(file_size "$dst")"
    [ "$ss" = "$ds" ] && return 0
  fi
  return 1
}

COPIED=0
SKIPPED=0

# True if any path component of the dest-relative path matches a credential
# entry name (leaf comparison per component), blocking files nested inside a
# credential-named directory anywhere in the tree.
rel_matches_credential() {
  local rel="$1"; shift
  local creds=("$@") comp cred credleaf
  rel="${rel//\\//}"
  local IFS=/
  for comp in $rel; do
    [ -z "$comp" ] && continue
    for cred in "${creds[@]+"${creds[@]}"}"; do
      credleaf="$(basename "${cred//\\//}")"
      [ "$comp" = "$credleaf" ] && return 0
    done
  done
  return 1
}

# Copy one regular file, honouring the merge policy and credential blocklist.
# Copies atomically (temp in dest dir, then rename over) so an interrupted copy
# never leaves a partial file masquerading as current.
copy_session_file() {
  local src="$1" dst="$2" no_merge="$3" dry_run="$4" rel="$5"
  shift 5
  local creds=("$@")
  rel_matches_credential "$rel" "${creds[@]+"${creds[@]}"}" && return 0
  if [ "$no_merge" != true ] && dest_is_current "$src" "$dst"; then
    SKIPPED=$((SKIPPED + 1)); return 0
  fi
  if [ "$dry_run" = true ]; then
    echo "  would copy $dst"; COPIED=$((COPIED + 1)); return 0
  fi
  local dstdir tmp
  dstdir="$(dirname "$dst")"
  mkdir -p "$dstdir"
  tmp="$(mktemp "$dstdir/.mcli-copy.XXXXXX")" || abort "cannot create temp file in $dstdir"
  cp -p "$src" "$tmp" || { rm -f "$tmp"; abort "copy failed: $src"; }
  mv -f "$tmp" "$dst"
  COPIED=$((COPIED + 1))
}

# Copy a single session entry (file or directory, merged per-file). Symlinks,
# hardlinks (nlink > 1), and any file whose resolved path escapes the source
# root are silently skipped so credential targets are never copied into the
# destination -- matching the PowerShell launcher's LinkType skip.
copy_session_entry() {
  local src="$1" dst="$2" no_merge="$3" dry_run="$4" rel_root="$5"
  shift 5
  local creds=("$@")
  [ -L "$src" ] && return 0
  [ -e "$src" ] || return 0
  if [ -f "$src" ]; then
    [ "$(file_nlink "$src")" -gt 1 ] && return 0
    copy_session_file "$src" "$dst" "$no_merge" "$dry_run" "$rel_root" \
      "${creds[@]+"${creds[@]}"}"
    return 0
  fi
  local src_root f rel
  src_root="$(cd "$src" 2>/dev/null && pwd -P)" || return 0
  while IFS= read -r -d '' f; do
    [ -L "$f" ] && continue
    [ -f "$f" ] || continue
    [ "$(file_nlink "$f")" -gt 1 ] && continue
    case "$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/" in
      "$src_root"/*|"$src_root"/) ;;
      *) continue ;;
    esac
    rel="${f#"$src"/}"
    copy_session_file "$f" "$dst/$rel" "$no_merge" "$dry_run" "$rel_root/$rel" \
      "${creds[@]+"${creds[@]}"}"
  done < <(find "$src" ! -type l -type f -print0 2>/dev/null)
}

# Copy every adapter-declared session path from src_dir to dst_dir.
copy_session_paths() {
  local tool="$1" src_dir="$2" dst_dir="$3" no_merge="$4" dry_run="$5"
  local apath entry creds=()
  apath="$(adapter_path "$tool")"
  while IFS= read -r entry; do
    [ -n "$entry" ] && creds+=("$entry")
  done < <(json_arr '.session.credentials' "$apath")
  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    copy_session_entry "$src_dir/$entry" "$dst_dir/$entry" \
      "$no_merge" "$dry_run" "$entry" "${creds[@]+"${creds[@]}"}"
  done < <(json_arr '.session.paths' "$apath")
}

# Abort if any schema-v2 session path is unsafe or overlaps a declared
# credential -- the same invariant assert_session_paths_safe enforces for
# schema-v1 adapters, read from the v2 field names.
assert_isolated_session_paths_safe() {
  local tool="$1" apath p c
  apath="$(adapter_path "$tool")"
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    assert_relpath_safe "$c" "credential" "$tool"
  done < <(json_arr '.account.credentialFiles' "$apath")
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    assert_relpath_safe "$p" "session path" "$tool"
    while IFS= read -r c; do
      [ -z "$c" ] && continue
      if [ "$p" = "$c" ] || [[ "$p" == "$c"/* ]] || [[ "$c" == "$p"/* ]]; then
        abort "adapter bug: session path '$p' overlaps credential '$c' in $tool"
      fi
    done < <(json_arr '.account.credentialFiles' "$apath")
  done < <(json_arr '.normalState.sessionPaths' "$apath")
}

# Copy the schema-v2 session paths between two endpoints with the declared
# credential files as the blocklist (isolated profiles share nothing, so
# continuation is a real copy, exactly like legacy endpoints).
copy_isolated_session_paths() {
  local tool="$1" src_dir="$2" dst_dir="$3" no_merge="$4" dry_run="$5"
  local apath entry state_subdir src_state dst_state creds=()
  apath="$(adapter_path "$tool")"
  state_subdir="$(json_str '.normalState.runtimeSubdir' "$apath")"
  src_state="$src_dir"; dst_state="$dst_dir"
  [ -n "$state_subdir" ] && src_state="$src_dir/$state_subdir" && dst_state="$dst_dir/$state_subdir"
  while IFS= read -r entry; do
    [ -n "$entry" ] && creds+=("$entry")
  done < <(json_arr '.account.credentialFiles' "$apath")
  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    copy_session_entry "$src_state/$entry" "$dst_state/$entry" \
      "$no_merge" "$dry_run" "$entry" "${creds[@]+"${creds[@]}"}"
  done < <(json_arr '.normalState.sessionPaths' "$apath")
}

path_is_reparse_point() {
  local path="$1" ps_path
  [ -L "$path" ] && return 0
  [ -e "$path" ] || return 1
  [ "$(platform)" = windows ] || return 1
  command -v powershell.exe >/dev/null 2>&1 || return 1
  ps_path="$path"
  if command -v cygpath >/dev/null 2>&1; then
    ps_path="$(cygpath -w "$path" 2>/dev/null || printf '%s' "$path")"
  fi
  MULTICLI_REPARSE_PATH="$ps_path" powershell.exe -NoProfile -Command '
    $path = $env:MULTICLI_REPARSE_PATH
    if (-not (Test-Path -LiteralPath $path)) { exit 1 }
    $item = Get-Item -LiteralPath $path -Force
    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { exit 0 }
    exit 1
  ' >/dev/null 2>&1
}

isolated_clone_fail() {
  ISOLATED_CLONE_ERROR="$1"
  return 1
}

copy_isolated_clone_entry() {
  local src="$1" dst="$2" src_root="$3" rel="$4"
  local canonical entry name
  if [ ! -e "$src" ] && [ ! -L "$src" ]; then
    return 0
  fi
  if path_is_reparse_point "$src"; then
    isolated_clone_fail "Cannot clone isolated profile: '$rel' is a reparse point inside allowlisted state. Remove the link and retry."
    return 1
  fi
  canonical="$(transfer_canonical "$src" 2>/dev/null || true)"
  if [ -z "$canonical" ]; then
    isolated_clone_fail "Cannot clone isolated profile: '$rel' cannot be resolved."
    return 1
  fi
  if ! transfer_path_within "$canonical" "$src_root"; then
    isolated_clone_fail "Cannot clone isolated profile: '$rel' resolves outside the isolated profile state root. Remove the link and retry."
    return 1
  fi
  if [ -f "$src" ]; then
    if [ "$(file_nlink "$src")" -gt 1 ]; then
      isolated_clone_fail "Cannot clone isolated profile: '$rel' is a hardlink inside allowlisted state. Remove the link and retry."
      return 1
    fi
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst" || {
      isolated_clone_fail "Cannot clone isolated profile: copy failed for '$rel'."
      return 1
    }
    return 0
  fi
  if [ ! -d "$src" ]; then
    return 0
  fi
  mkdir -p "$dst"
  while IFS= read -r -d '' entry; do
    name="$(basename "$entry")"
    copy_isolated_clone_entry "$entry" "$dst/$name" "$src_root" "$rel/$name" || return 1
  done < <(find "$src" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

copy_isolated_clone_paths() {
  local tool="$1" src_dir="$2" dst_dir="$3"
  local apath rel state_subdir src_state dst_state src_root
  apath="$(adapter_path "$tool")"
  state_subdir="$(json_str '.normalState.runtimeSubdir' "$apath")"
  src_state="$src_dir"; dst_state="$dst_dir"
  [ -n "$state_subdir" ] && src_state="$src_dir/$state_subdir" && dst_state="$dst_dir/$state_subdir"
  src_root="$(storage_canonical "$src_state" 2>/dev/null || true)"
  [ -n "$src_root" ] || isolated_clone_fail "Cannot clone isolated profile: source state root '$src_state' cannot be resolved."
  [ -n "$src_root" ] || return 1
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    if [ -e "$src_state/$rel" ] || [ -L "$src_state/$rel" ]; then
      copy_isolated_clone_entry "$src_state/$rel" "$dst_state/$rel" "$src_root" "$rel" || return 1
    fi
  done < <({ runtime_json_arr '.normalState.sharedPaths' "$apath"; runtime_json_arr '.normalState.sessionPaths' "$apath"; } | sort -u)
}

# nini-agents continue <tool> <src> <dest>: copy adapter-declared session state
# between endpoints ('base' = the tool's real home). Merge policy keeps the
# newer file; credential paths never travel. Schema-v2 tools already share
# sessions, so this is a no-op message there.
cmd_continue() {
  local tool="" src="" dst="" no_merge=false dry_run=false
  local positionals=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-merge) no_merge=true ;;
      --dry-run)  dry_run=true ;;
      --*)        abort "Unknown option '$1'. Usage: nini-agents continue <tool> <src> <dest> [--no-merge] [--dry-run]" ;;
      *)          positionals+=("$1") ;;
    esac
    shift
  done
  tool="${positionals[0]:-}"; src="${positionals[1]:-}"; dst="${positionals[2]:-}"
  if [ -z "$tool" ] || [ -z "$src" ] || [ -z "$dst" ]; then
    abort "Usage: nini-agents continue <tool> <src-profile> <dest-profile> [--no-merge] [--dry-run]"
  fi
  [ "$src" = "$dst" ] && abort "Source and destination must differ"

  local apath
  apath="$(adapter_path "$tool")"
  assert_adapter_valid "$tool"
  if [ "$(json_str '.schemaVersion' "$apath")" = 2 ]; then
    # Isolated profiles share nothing, so continuation is a real copy between
    # them (and 'base'), exactly like legacy endpoints. Shared schema-v2
    # profiles keep the no-op.
    local src_dir dst_dir
    src_dir="$(resolve_session_endpoint "$tool" "$src")" || abort "Cannot resolve source '$src'"
    dst_dir="$(resolve_session_endpoint "$tool" "$dst")" || abort "Cannot resolve destination '$dst'"
    [ -d "$src_dir" ] || abort "Source endpoint '$src' not found at $src_dir"
    [ -d "$dst_dir" ] || abort "Destination endpoint '$dst' not found. Create with: nini-agents new $tool/$dst"
    if [ ! -f "$src_dir/.isolated" ] && [ ! -f "$dst_dir/.isolated" ]; then
      echo "$(json_str '.displayName' "$apath") profiles already share conversations through the shared normal state; nothing to continue."
      return 0
    fi
    json_arr '.normalState.sessionPaths' "$apath" | grep -q . || \
      abort "$(json_str '.displayName' "$apath") declares no session paths; nothing to continue."
    assert_isolated_session_paths_safe "$tool"

    COPIED=0; SKIPPED=0
    copy_isolated_session_paths "$tool" "$src_dir" "$dst_dir" "$no_merge" "$dry_run"

    if [ "$COPIED" -eq 0 ] && [ "$SKIPPED" -eq 0 ]; then
      echo "No session state found for $tool/$src -- nothing to continue."
      return 0
    fi
    local verb="Copied"; [ "$dry_run" = true ] && verb="Would copy"
    echo "$verb $COPIED file(s), skipped $SKIPPED (same-or-newer)."
    return 0
  fi
  if [ "$(json_str '.session.portable' "$apath")" != true ]; then
    abort "$(json_str '.displayName' "$apath") sessions are not portable: $(json_str '.session.reason' "$apath")"
  fi

  assert_session_paths_safe "$tool"

  local src_dir dst_dir
  src_dir="$(resolve_session_endpoint "$tool" "$src")" || abort "Cannot resolve source '$src'"
  dst_dir="$(resolve_session_endpoint "$tool" "$dst")" || abort "Cannot resolve destination '$dst'"
  [ -d "$src_dir" ] || abort "Source endpoint '$src' not found at $src_dir"
  [ -d "$dst_dir" ] || abort "Destination endpoint '$dst' not found. Create with: nini-agents new $tool/$dst"

  COPIED=0; SKIPPED=0
  copy_session_paths "$tool" "$src_dir" "$dst_dir" "$no_merge" "$dry_run"

  if [ "$COPIED" -eq 0 ] && [ "$SKIPPED" -eq 0 ]; then
    echo "No session state found for $tool/$src -- nothing to continue."
    return 0
  fi
  local verb="Copied"; [ "$dry_run" = true ] && verb="Would copy"
  echo "$verb $COPIED file(s), skipped $SKIPPED (same-or-newer)."
  echo "$(json_str '.session.resumeHint' "$apath")"
}

# Total size in bytes of the adapter-declared session paths under base_dir.
session_state_size() {
  local tool="$1" base_dir="$2" apath entry total=0 bytes
  apath="$(adapter_path "$tool")"
  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    [ -e "$base_dir/$entry" ] || continue
    bytes="$(du -sk "$base_dir/$entry" 2>/dev/null | awk '{print $1 * 1024}')" || bytes=0
    total=$((total + bytes))
  done < <(json_arr '.session.paths' "$apath")
  printf '%s\n' "$total"
}

# Seed session state from base into a new profile, with a size guard: above the
# threshold we skip the copy and tell the user how to pull it in manually.
seed_session_state() {
  local tool="$1" base_dir="$2" pdir="$3" name bytes human
  assert_session_paths_safe "$tool"
  COPIED=0; SKIPPED=0
  bytes="$(session_state_size "$tool" "$base_dir")"
  if [ "$bytes" -gt "$SEED_MAX_BYTES" ]; then
    human="$(format_bytes "$bytes")"
    name="$(basename "$pdir")"
    echo "base session state is $human; skipped automatic copy -- run: nini-agents continue $tool base $name"
    return 0
  fi
  copy_session_paths "$tool" "$base_dir" "$pdir" false false
  [ "$COPIED" -gt 0 ] && echo "seeding $COPIED session file(s) from base"
  return 0
}

# Seed a freshly created profile from the tool's system home: session state
# plus (for plain profiles) the adapter's linkable assets.
seed_profile_from_base() {
  local tool="$1" pdir="$2" shared="$3"
  local apath base_dir
  apath="$(adapter_path "$tool")"
  base_dir="$(adapter_system_home "$tool")" || base_dir=""
  local seeded=()

  if [ -n "$base_dir" ] && [ -d "$base_dir" ] && \
     [ "$(json_str '.session.portable' "$apath")" = true ]; then
    seed_session_state "$tool" "$base_dir" "$pdir"
    [ "$COPIED" -gt 0 ] && seeded+=("session state ($COPIED file(s))")
  fi

  if [ "$shared" != true ] && [ -n "$base_dir" ] && [ -d "$base_dir" ]; then
    local entry copied_assets=0
    while IFS= read -r entry; do
      [ -z "$entry" ] && continue
      if [ -e "$base_dir/$entry" ] && [ ! -e "$pdir/$entry" ]; then
        cp -R "$base_dir/$entry" "$pdir/$entry" 2>/dev/null && copied_assets=$((copied_assets + 1))
      fi
    done < <(json_arr '.share.linkable' "$apath")
    [ "$copied_assets" -gt 0 ] && seeded+=("$copied_assets shared asset(s)")
  fi

  if [ "${#seeded[@]}" -gt 0 ]; then
    local IFS=", "
    echo "Seeded from base: ${seeded[*]}"
  fi
}

# =============================================================================
# Profile CRUD
# =============================================================================

# Write .profile.json for any isolated schema-v2 profile atomically. The
# unique profileId keeps lifecycle and optional OS-store credentials distinct.
write_isolated_profile_metadata() {
  local manifest="$1" pdir="$2" tmp
  tmp="$pdir/.profile.json.tmp"
  jq -n \
    --arg adapter_id "$(runtime_json_str '.id' "$manifest")" \
    --arg profile_id "$(runtime_new_profile_id)" \
    '{schemaVersion:2,adapterId:$adapter_id,profileId:$profile_id,mode:"isolated"}' > "$tmp"
  mv -f "$tmp" "$pdir/.profile.json"
}

cmd_new() {
  local spec="$1"; shift
  local shared=false cli=false from_template="" seed=true isolated=false

  while [ $# -gt 0 ]; do
    case "$1" in
      --shared)  shared=true ;;
      --isolated|--isolate|-i) isolated=true ;;
      --cli)     cli=true ;;
      --no-seed) seed=false ;;
      --from)    shift; from_template="${1:-}"; [ -z "$from_template" ] && abort "Usage: --from <template>" ;;
      *)         abort "Unknown option for new: '$1'. Run: nini-agents help" ;;
    esac
    shift
  done

  split_profile_spec "$spec"
  validate_name "$NAME"
  local apath pdir strategy mechanism
  apath="$(adapter_path "$TOOL")"
  assert_adapter_valid "$TOOL"
  pdir="$(profile_dir "$TOOL" "$NAME")"
  strategy="$(json_str '.isolation.strategy' "$apath")"
  mechanism="$(json_str '.account.mechanism' "$apath")"

  [ "$shared" = true ] && [ "$isolated" = true ] && \
    abort "--shared and --isolated are mutually exclusive: choose one profile mode."
  if [ "$isolated" = true ] && [ "$strategy" != "accountOverlay" ]; then
    abort "--isolated applies to schema-v2 (accountOverlay) adapters; '$TOOL' uses '$strategy', which already isolates the whole root per profile."
  fi
  if [ "$isolated" = true ] && [ "$mechanism" = "osUserCredentialStore" ]; then
    abort "Adapter '$TOOL' cannot use --isolated because folder redirection does not isolate the OS credential store."
  fi

  [ -d "$pdir" ] && abort "Profile '$spec' already exists"
  if [ -n "$from_template" ] && [ "$strategy" != "accountOverlay" ]; then
    legacy_template_apply_blocked "$spec" "$from_template"
  fi
  mkdir -p "$(tool_profiles_dir "$TOOL")"

  if [ -n "$from_template" ]; then
    local tdir="$(templates_dir)/$from_template"
    [ -d "$tdir" ] || abort "Template '$from_template' not found"
    if [ "$strategy" = "accountOverlay" ]; then
      # Validate before creating the profile, then place payload files where
      # the selected mode actually launches them.
      transfer_assert_template_compatible "$tdir" "$apath"
      mkdir -p "$pdir"
      transfer_apply_template "$tdir" "$apath" "$pdir" "$isolated"
    fi
  elif [ "$shared" = true ] && [ "$strategy" != "accountOverlay" ]; then
    create_shared_profile "$TOOL" "$pdir"
  else
    mkdir -p "$pdir"
  fi

  if [ "$isolated" = true ]; then
    touch "$pdir/.isolated"
    # Every isolated schema-v2 profile carries a unique profileId. Lifecycle
    # operations then stay on the allowlisted transfer path instead of the
    # legacy whole-directory clone/export path.
    if [ ! -f "$pdir/.profile.json" ]; then
      write_isolated_profile_metadata "$apath" "$pdir"
    fi
  elif [ "$strategy" = "accountOverlay" ]; then
    runtime_initialize_profile "$apath" "$pdir"
  fi

  if [ "$strategy" = "redirectHome" ]; then
    local hdir="$pdir/_home"
    mkdir -p "$hdir"
    set_redirect_home_links "$TOOL" "$hdir"
  fi

  [ "$cli" = true ] && touch "$pdir/.cli"

  if [ "$seed" = true ] && [ -z "$from_template" ] && [ "$strategy" != "accountOverlay" ]; then
    seed_profile_from_base "$TOOL" "$pdir" "$shared"
  fi

  create_shell_alias "$TOOL" "$NAME"
  if [ "$cli" != true ] && [ "$(json_str '.kind' "$apath")" != cli ]; then
    create_shortcut "$TOOL" "$NAME"
  fi

  local display mode_note=""
  display="$(json_str '.displayName' "$apath")"
  [ "$isolated" = true ] && mode_note=", isolated"
  echo "Created profile $spec ($display, strategy=$strategy$mode_note)"
  if ! alias_dir_in_path; then
    echo ""
    echo "Tip: add $(alias_dir) to PATH to use '$TOOL-$NAME' as a command."
  fi
}

# A --shared profile links the adapter's share.linkable entries from the
# tool's system home into the profile dir (copy fallback when linking fails).
create_shared_profile() {
  local tool="$1" pdir="$2"
  local apath sys_home entry src dst
  apath="$(adapter_path "$tool")"
  mkdir -p "$pdir"
  touch "$pdir/.shared"

  sys_home="$(json_str '.share.systemHome' "$apath")"
  [ -z "$sys_home" ] && return
  sys_home="$(resolve_path_token "$sys_home")"
  [ -d "$sys_home" ] || return

  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    src="$sys_home/$entry"
    dst="$pdir/$entry"
    if [ -e "$src" ] && [ ! -e "$dst" ]; then
      ln -s "$src" "$dst" 2>/dev/null || cp -R "$src" "$dst" 2>/dev/null || true
    fi
  done < <(json_arr '.share.linkable' "$apath")
}

# Link the adapter's shareFromRealHome dotfiles from the real $HOME into the
# redirected profile home, leaving existing entries alone.
set_redirect_home_links() {
  local tool="$1" hdir="$2"
  local apath entry src dst
  apath="$(adapter_path "$tool")"
  while IFS= read -r entry; do
    [ -z "$entry" ] && continue
    src="$HOME/$entry"
    dst="$hdir/$entry"
    if [ -e "$src" ] && [ ! -e "$dst" ]; then
      ln -s "$src" "$dst" 2>/dev/null || true
    fi
  done < <(json_arr '.isolation.shareFromRealHome' "$apath")
}

cmd_delete() {
  local spec="$1" confirmed="${2:-false}"
  split_profile_spec "$spec"
  validate_name "$NAME"
  local pdir="$(profile_dir "$TOOL" "$NAME")"
  [ -d "$pdir" ] || abort "Profile '$spec' does not exist"

  if [ "$confirmed" != true ]; then
    printf "Delete profile '%s' and all its data? [y/N] " "$spec"
    read -r confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }
  fi

  if [ -f "$pdir/.profile.json" ]; then
    local apath mechanism env_var profile_id
    apath="$(adapter_path "$TOOL")"
    mechanism="$(json_str '.account.mechanism' "$apath" 2>/dev/null || echo '')"
    if [ "$mechanism" = processSecret ]; then
      env_var="$(json_str '.account.secret.environmentVariable' "$apath")"
      profile_id="$(json_str '.profileId' "$pdir/.profile.json")"
      if [ -n "$env_var" ] && [ -n "$profile_id" ]; then
        mc_cred_clear "$(mc_cred_target "$TOOL" "$profile_id" "$env_var")" || \
          abort "Could not clear the process-secret credential for '$spec'; the profile was preserved. Resolve the credential-store error, then retry deletion."
      fi
    fi
  fi
  if [ -f "$pdir/.osuser.json" ]; then
    mc_osuser_remove "$pdir" || abort "Could not clean up OS-user isolation for '$spec'; the profile was preserved. Resolve the cleanup error, then retry deletion."
  fi
  rm -rf "$pdir"
  remove_shell_alias "$TOOL" "$NAME"
  remove_shortcut "$TOOL" "$NAME"
  echo "Deleted profile '$spec'"
}

cmd_rename() {
  local old="$1" new="$2"
  split_profile_spec "$old"; local ot="$TOOL" on="$NAME"
  split_profile_spec "$new"; local nt="$TOOL" nn="$NAME"
  [ "$ot" = "$nt" ] || abort "Cannot rename across tools"
  validate_name "$on"; validate_name "$nn"
  local odir="$(profile_dir "$ot" "$on")" ndir="$(profile_dir "$nt" "$nn")"
  [ -d "$odir" ] || abort "Profile '$old' does not exist"
  [ -d "$ndir" ] && abort "Profile '$new' already exists"
  mv "$odir" "$ndir"
  remove_shell_alias "$ot" "$on"; remove_shortcut "$ot" "$on"
  create_shell_alias "$nt" "$nn"; create_shortcut "$nt" "$nn"
  echo "Renamed '$old' to '$new'"
}

cmd_clone() {
  local src="$1" dest="$2"
  split_profile_spec "$src"; local st="$TOOL" sn="$NAME"
  split_profile_spec "$dest"; local dt="$TOOL" dn="$NAME"
  [ "$st" = "$dt" ] || abort "Cannot clone across tools"
  validate_name "$sn"; validate_name "$dn"
  local sdir="$(profile_dir "$st" "$sn")" ddir="$(profile_dir "$dt" "$dn")"
  [ -d "$sdir" ] || abort "Source profile '$src' does not exist"
  [ -d "$ddir" ] && abort "Destination profile '$dest' already exists"
  local apath="$(adapter_path "$st")"
  if [ -f "$sdir/.profile.json" ]; then
    local mode rel
    mode="$(json_str '.mode' "$sdir/.profile.json")"
    mkdir -p "$ddir"
    if [ "$mode" = isolated ]; then
      ISOLATED_CLONE_ERROR=""
      if ! copy_isolated_clone_paths "$st" "$sdir" "$ddir"; then
        rm -rf "$ddir"
        abort "${ISOLATED_CLONE_ERROR:-Cannot clone isolated profile safely.}"
      fi
      : > "$ddir/.isolated"
      write_isolated_profile_metadata "$apath" "$ddir"
    else
      runtime_initialize_profile "$apath" "$ddir"
    fi
  else
    legacy_transfer_blocked "clone" "$src"
  fi
  create_shell_alias "$dt" "$dn"; create_shortcut "$dt" "$dn"
  echo "Cloned '$src' to '$dest'"
}

# nini-agents auth set|status|clear: manage a process-secret profile's
# credential in the OS store, keyed by the profile's stable profileId.
# 'set' reads the secret from the tty (hidden) or stdin, never from argv.
cmd_auth() {
  local action="${1:-}" spec="${2:-}"
  [ -n "$action" ] && [ -n "$spec" ] || abort "Usage: nini-agents auth <set|status|clear> <tool>/<profile>"
  split_profile_spec "$spec"
  validate_name "$NAME"
  local apath mechanism env_var pdir profile_id target
  apath="$(adapter_path "$TOOL")"
  assert_adapter_valid "$TOOL"
  mechanism="$(json_str '.account.mechanism' "$apath")"
  [ "$mechanism" = processSecret ] || abort "Tool '$TOOL' does not use a process-secret credential."
  env_var="$(json_str '.account.secret.environmentVariable' "$apath")"
  [ -n "$env_var" ] || abort "Adapter '$TOOL' is missing account.secret.environmentVariable."
  pdir="$(profile_dir "$TOOL" "$NAME")"
  [ -f "$pdir/.profile.json" ] || abort "Schema-v2 profile '$spec' does not exist."
  profile_id="$(json_str '.profileId' "$pdir/.profile.json")"
  target="$(mc_cred_target "$TOOL" "$profile_id" "$env_var")"

  case "$action" in
    set)
      local secret
      if [ -t 0 ]; then
        read -r -s -p "Enter $env_var for $spec: " secret
        echo ""
      else
        IFS= read -r secret
      fi
      mc_cred_set "$target" "$secret"
      echo "Stored credential for $spec."
      ;;
    status)
      if mc_cred_present "$target"; then
        echo "Credential present for $spec."
      else
        echo "No credential stored for $spec."
        return 1
      fi
      ;;
    clear)
      mc_cred_clear "$target"
      echo "Cleared credential for $spec."
      ;;
    *) abort "Usage: nini-agents auth <set|status|clear> <tool>/<profile>" ;;
  esac
}

# =============================================================================
# Aliases & shortcuts
# =============================================================================

# Write <tool>-<name> (and, if free, <name>) alias scripts into the alias dir.
# The generated script execs this launcher with the profile spec. Paths are
# written inside double quotes -- never printf %q, which backslash-escapes
# spaces that bash then passes through literally inside "...".
create_shell_alias() {
  local tool="$1" name="$2"
  local adir="$(alias_dir)"
  mkdir -p "$adir"
  local apath="$adir/$tool-$name"
  local launcher="$SCRIPT_DIR/nini-agents"
  cat > "$apath" <<ALIAS
#!/usr/bin/env bash
exec "$launcher" launch "$tool/$name" "\$@"
ALIAS
  chmod +x "$apath"

  local short_alias="$adir/$name"
  if [ ! -f "$short_alias" ]; then
    cat > "$short_alias" <<ALIAS
#!/usr/bin/env bash
exec "$launcher" launch "$tool/$name" "\$@"
ALIAS
    chmod +x "$short_alias"
  fi
}

remove_shell_alias() {
  local tool="$1" name="$2"
  local apath="$(alias_dir)/$tool-$name"
  [ -f "$apath" ] && rm -f "$apath"

  local short_alias="$(alias_dir)/$name"
  if [ -f "$short_alias" ] && grep -qF "$tool/$name" "$short_alias" 2>/dev/null; then
    rm -f "$short_alias"
  fi
}

# True when the alias dir is on this shell's PATH (exact component match).
alias_dir_in_path() {
  local d="$(alias_dir)"
  [[ ":$PATH:" == *":$d:"* ]]
}

create_shortcut() {
  local tool="$1" name="$2"
  case "$(platform)" in
    macos) create_shortcut_macos "$tool" "$name" ;;
    linux)  create_shortcut_linux "$tool" "$name" ;;
  esac
}

remove_shortcut() {
  local tool="$1" name="$2"
  case "$(platform)" in
    macos)
      local target="$HOME/Applications/nini-agents $tool $name.app"
      [ -d "$target" ] && rm -rf "$target"
      target="$HOME/Applications/multi-cli $tool $name.app"
      [ -d "$target" ] && rm -rf "$target"
      ;;
    linux)
      local lp="$HOME/.local/share/multicli/launchers/$tool-$name.sh"
      [ -f "$lp" ] && rm -f "$lp"
      local dp="$HOME/.local/share/applications/multicli-$tool-$name.desktop"
      [ -f "$dp" ] && rm -f "$dp"
      ;;
  esac
  return 0
}

create_shortcut_macos() {
  local tool="$1" name="$2"
  local app_dir="$HOME/Applications/nini-agents $tool $name.app"
  local run_script="$app_dir/Contents/MacOS/run"
  local launcher="$SCRIPT_DIR/nini-agents"
  local icon_src="$SCRIPT_DIR/scripts/icon.icns"

  mkdir -p "$app_dir/Contents/MacOS" "$app_dir/Contents/Resources"

  cat > "$run_script" <<APPRUN
#!/usr/bin/env bash
export MULTICLI_HOME=$(printf '%q' "$BASE")
exec $(printf '%q' "$launcher") launch $(printf '%q' "$tool/$name") "\$@"
APPRUN
  chmod +x "$run_script"

  [ -f "$icon_src" ] && cp "$icon_src" "$app_dir/Contents/Resources/icon.icns"

  cat > "$app_dir/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>run</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleIdentifier</key>
  <string>com.multicli.profile.$tool.$name</string>
  <key>CFBundleName</key>
  <string>nini-agents $tool $name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
