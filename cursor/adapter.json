{
  "schemaVersion": 2,
  "id": "cursor",
  "displayName": "Cursor Desktop",
  "kind": "hybrid",
  "binary": {
    "windows": [
      "%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe",
      "%LOCALAPPDATA%\\Programs\\cursor\\resources\\app\\bin\\cursor.cmd",
      "cursor"
    ],
    "macos": [
      "/Applications/Cursor.app/Contents/MacOS/Cursor",
      "$HOME/Applications/Cursor.app/Contents/MacOS/Cursor",
      "cursor"
    ],
    "linux": ["/usr/bin/cursor", "/opt/Cursor/cursor", "$HOME/.local/bin/cursor", "cursor"]
  },
  "isolation": {
    "strategy": "accountOverlay",
    "mode": "detached",
    "args": [],
    "env": {},
    "clearEnv": []
  },
  "account": {
    "mechanism": "inseparable",
    "credentialFiles": [],
    "credentialPrecedence": [],
    "logoutScope": "user",
    "reason": "Desktop credentials, chat state, SQLite global storage, and singleton behavior do not have a proven narrow split."
  },
  "normalState": {
    "root": {
      "windows": "%USERPROFILE%\\.cursor",
      "macos": "$HOME/.cursor",
      "linux": "$HOME/.cursor"
    },
    "sharedPaths": [],
    "sessionPaths": [],
    "filePaths": [],
    "unsafePaths": []
  },
  "concurrency": { "level": "unsupported", "singletonScope": "user" },
  "support": {
    "windows": { "level": "unsupported", "reason": "User-data flags do not prove separate desktop auth with shared conversations." },
    "macos": { "level": "unsupported", "reason": "User-data flags do not prove separate desktop auth with shared conversations." },
    "linux": { "level": "unsupported", "reason": "User-data flags do not prove separate desktop auth with shared conversations." }
  },
  "install": "https://cursor.com/download",
  "versionCommand": ["--version"]
}
